# Xiaomi Pad 6S Pro (sheng / SM8550) device constants.
# boot_a and boot_b are 192 MiB each (BoardConfig.mk: BOARD_BOOTIMAGE_PARTITION_SIZE).
SHENG_BOOT_PARTITION_SIZE=201326592
SHENG_PAGE_SIZE=4096
SHENG_DEFAULT_OS=android
SHENG_TIMEOUT_MS=8000
SHENG_BOOTARGS="root=PARTLABEL=linux rw rootwait"
# Extraction prefixes used by scripts/prepare.sh.
SHENG_STOCK_PREFIX=stock
SHENG_LINUX_PREFIX=linux
