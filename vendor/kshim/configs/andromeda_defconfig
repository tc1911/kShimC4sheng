# Xiaomi Mi Mix 3 5G (andromeda): DT-driven devices; optional standalone UEFI FD destination.
# Hardware data independently checked against MiCode andromeda-p-oss at
# 74347f5521fb444936f5986ff0937264307d78fe; see configs/andromeda-provenance.json.
CONFIG_QCOM_KEYS=y
CONFIG_QCOM_SPMI=y
CONFIG_QCOM_KEY_DEBOUNCE_SAMPLES=2
# CONFIG_KSHIM_QEMU_PLATFORM is not set
CONFIG_KSHIM_FRAMEBUFFER=y
CONFIG_KSHIM_LVGL=y
CONFIG_KSHIM_LVGL_BUFFER_BYTES=262144
CONFIG_KSHIM_UEFI_TEST_MENU=y
CONFIG_KSHIM_MENU_ENTRY1="UEFI A"
CONFIG_KSHIM_MENU_ENTRY2="UEFI B"
CONFIG_KSHIM_UEFI_LOAD_ADDRESS=0x9FC00000
CONFIG_KSHIM_UEFI_MAX_SIZE=0x300000
# CONFIG_ENABLE_BANNER is not set
CONFIG_DEBUG_LEVEL_NONE=y
CONFIG_ASSERT_HALT=y

CONFIG_KSHIM_SMP=y
CONFIG_KSHIM_SMP_WORKERS=7
CONFIG_KSHIM_TOUCH=y
