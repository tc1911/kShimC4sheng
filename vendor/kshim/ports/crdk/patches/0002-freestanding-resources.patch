+/* SPDX-License-Identifier: MIT */
+#pragma once
+#include <Library/cr_geni.h>
+#include <Library/gpio.h>
+
+enum CrQupStage {
+    CR_QUP_STAGE_NONE,
+    CR_QUP_STAGE_CMD_DB,
+    CR_QUP_STAGE_CLOCK,
+    CR_QUP_STAGE_GENI,
+    CR_QUP_STAGE_POWER,
+    CR_QUP_STAGE_RESET,
+    CR_QUP_STAGE_READY
+};
+
+/* Zero-initialize before first use. Private resource snapshots are stored here
+ * so failure cleanup never depends on allocation or on UEFI services. */
+struct CrQupResources;
+struct CrQupContext {
+    struct CrGeni i2c;
+    GpioDeviceContext gpio;
+    struct CrIo io;
+    enum CrQupStage stage;
+    const struct CrQupResources *board;
+    uint32_t rail_addresses[2];
+    uint32_t added_clock_votes, saved_rcg_config;
+    uint32_t saved_pins[3];
+    uint32_t saved_tcs[7];
+    uint8_t tcs_slot, rsc_major;
+    bool clocks_claimed, rcg_changed, pins_claimed;
+    bool tcs_claimed, tcs_pending, initialized;
+};
+
+
+struct CrRail {
+    const char *name;
+    uint16_t millivolts; /* Zero for an enable-only fixed XOB rail. */
+    uint8_t mode; /* Zero means preserve the inherited mode vote. */
+};
+struct CrQupResources {
+    uintptr_t geni, vote, rcg, ahb_halt[2], serial_halt;
+    size_t geni_size;
+    uint32_t ahb_votes, serial_vote;
+    uintptr_t bus_pins[2], irq_pin, reset_pin, gate_pin;
+    uint32_t irq_config, reset_config, gate_delay_us, reset_low_us;
+    uintptr_t cmd_db_base, cmd_db_dictionary;
+    size_t cmd_db_size;
+    uintptr_t rsc_base;
+    size_t rsc_size;
+    uint32_t tcs_offset, drv_id, active_offset, active_count;
+    uint32_t source_hz, speed_hz;
+    uint32_t bus_config[2];
+    bool irq_active_low;
+    struct CrRail rails[2];
+    unsigned rail_count;
+};
+
+int CrCmdDbLookup(const struct CrIo *io, uintptr_t base, size_t size,
+                  const char *name, uint32_t *address);
+int CrCmdDbLookupDictionary(const struct CrIo *io, uintptr_t dictionary,
+                            const char *name, uint32_t *address);
+int CrRpmhPollClaim(struct CrQupContext *p);
+int CrRpmhPollRestore(struct CrQupContext *p);
+int CrRpmhPollComplete(struct CrQupContext *p);
+int CrRpmhPollWrite(struct CrQupContext *p, uint32_t address, uint32_t value);
+int CrClockPollPrepare(struct CrQupContext *p, uint8_t *index);
+int CrClockPollRestore(struct CrQupContext *p);
+int CrQupInit(struct CrQupContext *p, const struct CrIo *io,
+              const struct CrQupResources *resources);
