+/* GENI_SE_FW_REVISION_RO fields */
+#define GENI_SE_FW_REV_PROTOCOL_MSK KGENI_MASK(15, 8)
+
+/* GENI_SE_CLK_SEL fields */
+#define GENI_SE_CLK_SEL_MSK KGENI_MASK(2, 0)
+
+/* GENI_SE_DMA_MODE_EN fields */
+#define GENI_SE_DMA_MODE_EN_BIT KGENI_BIT(0)
+
+/* GENI_SE_M_CMD0 / S_CMD0 fields */
+#define GENI_SE_CMD_OPCODE_MSK KGENI_MASK(31, 27)
+#define GENI_SE_CMD_PARAMS_MSK KGENI_MASK(26, 0)
+
+/* GENI_SE_M/S_CMD_CTRL_REG fields */
+#define GENI_SE_CMD_CTRL_GENI_CMD_CANCEL KGENI_BIT(2)
+#define GENI_SE_CMD_CTRL_GENI_CMD_ABORT KGENI_BIT(1)
+#define GENI_SE_CMD_CTRL_GENI_DISABLE KGENI_BIT(0)
+
+/* GENI_SE_M_IRQ_STATUS/EN/CLEAR fields */
+#define GENI_SE_M_IRQ_CMD_DONE KGENI_BIT(0)
+#define GENI_SE_M_IRQ_CMD_OVERRUN KGENI_BIT(1)
+#define GENI_SE_M_IRQ_ILLEGAL_CMD KGENI_BIT(2)
