+    GENI_SE_IRQ_EN
+};
+static const uint16_t spi_saved[] = {
+    SPI_GENI_SE_CPHA, SPI_GENI_SE_CPOL, SPI_GENI_SE_DEMUX_OUTPUT_INV,
+    SPI_GENI_SE_DEMUX_SEL, SPI_GENI_SE_TRANS_CFG, SPI_GENI_SE_WORD_LEN,
+    SPI_GENI_SE_LOOPBACK
+};
+#define ARRAY_COUNT(a) (sizeof(a) / sizeof((a)[0]))
+_Static_assert(ARRAY_COUNT(common_saved) + ARRAY_COUNT(spi_saved) ==
+               CR_GENI_SAVED_REGS, "saved GENI register count");
+
+static uint32_t rd(struct CrGeni *bus, uint32_t reg)
+{
+    return bus->io.read32(bus->io.context, bus->config.base + reg);
+}
+static void wr(struct CrGeni *bus, uint32_t reg, uint32_t value)
+{
+    bus->io.write32(bus->io.context, bus->config.base + reg, value);
+}
+static bool expired(struct CrGeni *bus, uint64_t start, uint32_t limit)
+{
+    return bus->io.now_us(bus->io.context) - start >= limit;
+}
+static int irq_error(struct CrGeni *bus, uint32_t irq, uint32_t opcode)
+{
+    if (bus->config.protocol == CR_GENI_I2C) {
+        /* Extracted from I2CCrDxe: the final data NACK of a read is normal.
+         * Address NACK and independent GP errors must still fail. */
+        if (opcode == I2C_GENI_M_CMD_OPCODE_READ && (irq & I2C_GENI_M_IRQ_NACK) && rd(bus, 0x910))
+            irq &= ~(I2C_GENI_M_IRQ_NACK | GENI_SE_M_IRQ_CMD_FAILURE);
+        if (irq & (1U << 9)) return CR_BUS_IO;
+        if (irq & I2C_GENI_M_IRQ_NACK)
+            return CR_BUS_NACK;
+        if (irq & I2C_GENI_M_IRQ_ARB_LOST)
+            return CR_BUS_AGAIN;
+        if (irq & I2C_GENI_M_IRQ_BUS_PROTO)
+            return CR_BUS_IO;
+    }
+    if (irq & (COMMON_ERRORS | GENI_SE_M_IRQ_CMD_CANCEL | GENI_SE_M_IRQ_CMD_ABORT))
+        return CR_BUS_IO;
+    return 0;
+}
+
+static int wait_control(struct CrGeni *bus, uint32_t control,
+                        uint32_t done)
+{
+    uint64_t start = bus->io.now_us(bus->io.context);
+    wr(bus, GENI_SE_M_IRQ_CLEAR, done);
+    wr(bus, GENI_SE_M_CMD_CTRL_REG, control);
+    for (uint32_t polls = 0; polls <= RECOVERY_TIMEOUT_US; ++polls) {
+        uint32_t irq = rd(bus, GENI_SE_M_IRQ_STATUS);
+        if (irq & done) {
+            wr(bus, GENI_SE_M_IRQ_CLEAR, irq);
+            if (!(rd(bus, GENI_SE_STATUS) & GENI_SE_STATUS_M_GENI_CMD_ACTIVE))
+                return 0;
+        }
+        if (expired(bus, start, RECOVERY_TIMEOUT_US))
+            break;
+        bus->io.delay_us(bus->io.context, 1);
+    }
+    return CR_BUS_TIMEOUT;
+}
+
+static int cancel_active(struct CrGeni *bus)
+{
+    int status;
+    wr(bus, GENI_SE_TX_WATERMARK_REG, 0);
+    if (!(rd(bus, GENI_SE_STATUS) & GENI_SE_STATUS_M_GENI_CMD_ACTIVE))
+        return 0;
+    status = wait_control(bus, GENI_SE_CMD_CTRL_GENI_CMD_CANCEL,
+                          GENI_SE_M_IRQ_CMD_CANCEL);
+    if (status)
+        status = wait_control(bus, GENI_SE_CMD_CTRL_GENI_CMD_ABORT,
+                              GENI_SE_M_IRQ_CMD_ABORT);
+    if (status)
+        bus->poisoned = true;
+    return status;
+}
+
+/* Payload is always 8-bit, packed four bytes per 32-bit FIFO word. */
+static int command(struct CrGeni *bus, uint32_t opcode, uint32_t params,
+                   const uint8_t *tx, uint8_t *rx, size_t length,
+                   uint64_t start, uint32_t timeout)
+{
+    size_t sent = 0, received = 0;
+    if (expired(bus, start, timeout))
+        return CR_BUS_TIMEOUT;
+    if (rd(bus, GENI_SE_STATUS) & GENI_SE_STATUS_M_GENI_CMD_ACTIVE)
+        return CR_BUS_BUSY;
+    if (tx)
+        wr(bus, I2C_GENI_SE_TX_TRANS_LEN, (uint32_t)length);
+    if (rx)
+        wr(bus, I2C_GENI_SE_RX_TRANS_LEN, (uint32_t)length);
+    wr(bus, GENI_SE_M_IRQ_CLEAR, UINT32_MAX);
+    wr(bus, GENI_SE_M_CMD0, (opcode << 27) | params);
+    wr(bus, GENI_SE_TX_WATERMARK_REG, tx ? 1U : 0U);
+    /* Poll-count guard also bounds broken/mocked timers. */
+    for (uint32_t polls = 0; polls <= timeout; ++polls) {
+        uint32_t irq = rd(bus, GENI_SE_M_IRQ_STATUS);
+        int status = irq_error(bus, irq, opcode);
+        if (status)
+            return status;
+        if (tx && sent < length && (irq & GENI_SE_M_IRQ_TX_FIFO_WATERMARK)) {
+            uint32_t used = rd(bus, GENI_SE_TX_FIFO_STATUS) & GENI_SE_TX_FIFO_WC_MSK;
+            if (used > bus->tx_depth)
+                return CR_BUS_IO;
+            for (uint32_t w = used; w < bus->tx_depth && sent < length; ++w) {
+                uint32_t word = 0;
+                for (unsigned b = 0; b < 4 && sent < length; ++b)
+                    word |= (uint32_t)tx[sent++] << (b * 8U);
+                wr(bus, GENI_SE_TX_FIFOn, word);
+            }
+            if (sent == length)
+                wr(bus, GENI_SE_TX_WATERMARK_REG, 0);
+        }
+        if (rx && (irq & (GENI_SE_M_IRQ_RX_FIFO_WATERMARK | GENI_SE_M_IRQ_RX_FIFO_LAST))) {
+            uint32_t fifo = rd(bus, GENI_SE_RX_FIFO_STATUS);
+            uint32_t words = fifo & GENI_SE_RX_FIFO_WC_MSK;
+            unsigned last_bytes = (fifo >> 28) & 7U;
+            if (words > bus->rx_depth || last_bytes > 4U)
+                return CR_BUS_IO;
+            for (uint32_t w = 0; w < words; ++w) {
+                uint32_t word = rd(bus, GENI_SE_RX_FIFOn);
+                unsigned bytes = 4;
+                if (w + 1U == words && (fifo & GENI_SE_RX_FIFO_LAST_MSK) && last_bytes)
+                    bytes = last_bytes;
+                if (bytes > length - received)
+                    return CR_BUS_IO;
+                for (unsigned b = 0; b < bytes; ++b)
+                    rx[received++] = (uint8_t)(word >> (b * 8U));
+            }
+        }
+        wr(bus, GENI_SE_M_IRQ_CLEAR, irq);
+        if (irq & GENI_SE_M_IRQ_CMD_DONE) {
+            if ((tx && sent != length) || (rx && received != length))
+                return CR_BUS_IO;
+            return 0;
+        }
+        if (expired(bus, start, timeout))
+            return CR_BUS_TIMEOUT;
+        bus->io.delay_us(bus->io.context, 1);
+    }
+    return CR_BUS_TIMEOUT;
+}
+
+static int release_lines(struct CrGeni *bus)
+{
+    uint32_t opcode;
+    int status = cancel_active(bus);
+    if (status)
+        return status;
+    /* A cancelled/short transfer must not leak old FIFO bytes into the next
+     * report. Never reuse a controller whose bounded drain cannot finish. */
+    uint32_t words = rd(bus, GENI_SE_RX_FIFO_STATUS) & GENI_SE_RX_FIFO_WC_MSK;
+    if (words > bus->rx_depth) {
+        bus->poisoned = true;
+        return CR_BUS_IO;
+    }
+    for (uint32_t i = 0; i < words; ++i)
+        (void)rd(bus, GENI_SE_RX_FIFOn);
+    if ((rd(bus, GENI_SE_TX_FIFO_STATUS) & GENI_SE_TX_FIFO_WC_MSK) ||
+        (rd(bus, GENI_SE_RX_FIFO_STATUS) & GENI_SE_RX_FIFO_WC_MSK)) {
+        bus->poisoned = true;
+        return CR_BUS_IO;
+    }
+    if (!bus->cs_asserted && !bus->i2c_held)
+        return 0;
+    opcode = bus->config.protocol == CR_GENI_SPI ?
+             SPI_GENI_M_CMD_OPCODE_CS_DEASSERT : I2C_GENI_M_CMD_OPCODE_STOP_ON_BUS;
+    status = command(bus, opcode, 0, NULL, NULL, 0,
+                     bus->io.now_us(bus->io.context), RECOVERY_TIMEOUT_US);
+    if (status) {
+        /* A failed release cannot be treated as a reusable controller. */
+        (void)cancel_active(bus);
+        bus->poisoned = true;
+        return status;
+    }
+    bus->cs_asserted = false;
+    bus->i2c_held = false;
+    return 0;
+}
+
+static void configure_packing(struct CrGeni *bus)
+{
+    uint32_t vec[4];
+    for (unsigned i = 0; i < 4; ++i)
+        vec[i] = ((i * 8U + 7U) << 5) | (1U << 4) | (7U << 1);
+    vec[3] |= 1U;
+    wr(bus, GENI_SE_TX_PACKING_CFG0, vec[0] | (vec[1] << 10));
+    wr(bus, GENI_SE_TX_PACKING_CFG1, vec[2] | (vec[3] << 10));
+    wr(bus, GENI_SE_RX_PACKING_CFG0, vec[0] | (vec[1] << 10));
+    wr(bus, GENI_SE_RX_PACKING_CFG1, vec[2] | (vec[3] << 10));
+    wr(bus, GENI_SE_BYTE_GRAN, 0);
+}
+
+int CrGeniInit(struct CrGeni *bus,
+                       const struct CrGeniConfig *config,
+                       const struct CrIo *io)
+{
+    uint32_t divisor, counters = 0;
+    if (!io)
+        io = CrIoDefault();
+    if (!bus || !config || !CrIoValid(io) || !config->base ||
+        config->size < 0xe34U || config->base > UINTPTR_MAX - config->size || (config->base & 3U) ||
+        !config->speed_hz || !config->source_hz || config->clock_index > 7 ||
+        config->spi_mode > 3 || config->chip_select > 3)
+        return CR_BUS_INVALID;
+    if (bus->initialized)
+        return CR_BUS_BUSY;
+    if (config->protocol == CR_GENI_I2C) {
+        if (config->source_hz != 19200000U)
+            return CR_BUS_UNSUPPORTED;
+        switch (config->speed_hz) {
+        /* MiCode andromeda-p-oss clock timing table, same as CrDK. */
+        case 100000: divisor = 7; counters = (10U << 20) | (11U << 10) | 26U; break;
+        case 400000: divisor = 2; counters = (5U << 20) | (12U << 10) | 24U; break;
+        case 1000000: divisor = 1; counters = (3U << 20) | (9U << 10) | 18U; break;
+        default: return CR_BUS_UNSUPPORTED;
+        }
+    } else if (config->protocol == CR_GENI_SPI) {
+        divisor = (uint32_t)(((uint64_t)config->source_hz + config->speed_hz - 1U) /
+                              config->speed_hz);
+        if (!divisor || divisor > 4095U)
+            return CR_BUS_UNSUPPORTED;
+    } else {
+        return CR_BUS_UNSUPPORTED;
+    }
+    *bus = (struct CrGeni){ .io = *io, .config = *config };
+    if (((rd(bus, GENI_SE_FW_REVISION_RO) >> 8) & 0xffU) != (unsigned)config->protocol ||
+        (rd(bus, GENI_SE_IF_DISABLE_RO) & GENI_SE_FIFO_IF_DISABLE))
+        return CR_BUS_UNSUPPORTED;
+    if (rd(bus, GENI_SE_STATUS) &
+        (GENI_SE_STATUS_M_GENI_CMD_ACTIVE | GENI_SE_STATUS_S_GENI_CMD_ACTIVE))
+        return CR_BUS_BUSY;
+    uint32_t tx = rd(bus, GENI_SE_HW_PARAM_0), rx = rd(bus, GENI_SE_HW_PARAM_1);
+    bus->tx_depth = (uint8_t)((tx >> 16) & 0x3fU);
+    bus->rx_depth = (uint8_t)((rx >> 16) & 0x3fU);
+    if (bus->tx_depth < 4 || bus->rx_depth < 4 ||
+        ((tx >> 24) & 0x3fU) != 32 || ((rx >> 24) & 0x3fU) != 32)
+        return CR_BUS_UNSUPPORTED;
+    if ((rd(bus, GENI_SE_TX_FIFO_STATUS) & GENI_SE_TX_FIFO_WC_MSK) ||
+        (rd(bus, GENI_SE_RX_FIFO_STATUS) & GENI_SE_RX_FIFO_WC_MSK))
+        return CR_BUS_BUSY;
+    for (size_t i = 0; i < ARRAY_COUNT(common_saved); ++i)
+        bus->saved[i] = rd(bus, common_saved[i]);
+    if (config->protocol == CR_GENI_SPI) {
+        for (size_t i = 0; i < ARRAY_COUNT(spi_saved); ++i)
+            bus->saved[ARRAY_COUNT(common_saved) + i] = rd(bus, spi_saved[i]);
+    } else {
+        bus->saved[ARRAY_COUNT(common_saved)] = rd(bus, I2C_GENI_SE_SCL_COUNTERS);
+    }
+    /* Local status is polled. The GIC is never enabled or reconfigured. */
+    wr(bus, GENI_SE_GSI_EVENT_EN, 0);
+    wr(bus, GENI_SE_IRQ_EN, 0);
+    wr(bus, GENI_SE_M_IRQ_CLEAR, UINT32_MAX);
+    wr(bus, GENI_SE_S_IRQ_CLEAR, UINT32_MAX);
+    wr(bus, GENI_SE_M_IRQ_EN, COMMON_ERRORS | I2C_GENI_M_IRQ_ERROR_MSK |
+       GENI_SE_M_IRQ_CMD_DONE | GENI_SE_M_IRQ_CMD_CANCEL | GENI_SE_M_IRQ_CMD_ABORT |
+       GENI_SE_M_IRQ_TX_FIFO_WATERMARK | GENI_SE_M_IRQ_RX_FIFO_WATERMARK |
+       GENI_SE_M_IRQ_RX_FIFO_LAST);
+    wr(bus, GENI_SE_S_IRQ_EN, 0);
+    wr(bus, GENI_SE_CGC_CTRL, rd(bus, GENI_SE_CGC_CTRL) | GENI_SE_DEFAULT_CGC_EN);
+    wr(bus, GENI_SE_DMA_GENERAL_CFG, rd(bus, GENI_SE_DMA_GENERAL_CFG) | 0xfU);
+    wr(bus, GENI_SE_OUTPUT_CTRL, GENI_SE_DEFAULT_IO_OUTPUT_CTRL_MSK);
+    wr(bus, GENI_SE_FORCE_DEFAULT_REG, GENI_SE_FORCE_DEFAULT);
+    wr(bus, GENI_SE_DMA_MODE_EN, rd(bus, GENI_SE_DMA_MODE_EN) & ~1U);
+    wr(bus, GENI_SE_TX_WATERMARK_REG, 0);
+    wr(bus, GENI_SE_RX_WATERMARK_REG, bus->rx_depth - 2U);
+    wr(bus, GENI_SE_RX_RFR_WATERMARK_REG, bus->rx_depth - 1U);
+    configure_packing(bus);
+    wr(bus, GENI_SE_CLK_SEL, config->clock_index);
+    wr(bus, GENI_SE_SER_M_CLK_CFG, (divisor << 4) | GENI_SE_SER_CLK_EN);
+    wr(bus, GENI_SE_SER_S_CLK_CFG, (divisor << 4) | GENI_SE_SER_CLK_EN);
+    if (config->protocol == CR_GENI_I2C) {
+        wr(bus, I2C_GENI_SE_SCL_COUNTERS, counters);
+    } else {
+        wr(bus, SPI_GENI_SE_WORD_LEN, 8U - SPI_GENI_MIN_WORD_LEN);
+        wr(bus, SPI_GENI_SE_CPHA, config->spi_mode & 1U);
+        wr(bus, SPI_GENI_SE_CPOL, (config->spi_mode & 2U) ? SPI_GENI_CPOL_BIT : 0U);
+        wr(bus, SPI_GENI_SE_DEMUX_SEL, config->chip_select);
+        wr(bus, SPI_GENI_SE_DEMUX_OUTPUT_INV, 0);
+        wr(bus, SPI_GENI_SE_LOOPBACK, 0);
+        wr(bus, SPI_GENI_SE_TRANS_CFG,
+           rd(bus, SPI_GENI_SE_TRANS_CFG) & ~SPI_GENI_TRANS_CFG_CS_TOGGLE);
+    }
+    bus->initialized = true;
+    return 0;
+}
+
+static int validate_bus(struct CrGeni *bus, enum CrGeniProtocol protocol)
+{
+    if (!bus || !bus->initialized || bus->config.protocol != protocol)
+        return CR_BUS_INVALID;
+    if (bus->poisoned)
+        return CR_BUS_IO;
+    if (bus->busy)
+        return CR_BUS_BUSY;
+    return 0;
+}
+
+static int i2c_transfer(struct CrGeni *bus,
+                      const struct CrI2cMessage *messages, size_t count,
+                      uint32_t timeout_us, bool stop)
+{
+    int status = validate_bus(bus, CR_GENI_I2C);
+    if (status)
+        return status;
+    if (!messages || !count || count > 32 || timeout_us > 1000000U)
+        return CR_BUS_INVALID;
+    for (size_t i = 0; i < count; ++i)
+        if (messages[i].address > 0x7fU || !messages[i].data ||
+            !messages[i].length || messages[i].length > MAX_TRANSFER_BYTES)
+            return CR_BUS_INVALID;
+    if (rd(bus, GENI_SE_STATUS) & GENI_SE_STATUS_M_GENI_CMD_ACTIVE)
+        return CR_BUS_BUSY;
+    uint64_t start = bus->io.now_us(bus->io.context);
+    uint32_t timeout = timeout_us ? timeout_us : DEFAULT_TIMEOUT_US;
+    bus->busy = true;
+    for (size_t i = 0; i < count; ++i) {
+        const struct CrI2cMessage *msg = &messages[i];
+        bool hold = i + 1 < count || !stop;
+        uint32_t params = ((uint32_t)msg->address << 9) |
+            (hold ? I2C_GENI_M_CMD_PARAM_STOP_STRETCH : 0U);
+        /* An error may happen after START; always attempt STOP recovery. */
+        bus->i2c_held = true;
+        status = command(bus, msg->read ? I2C_GENI_M_CMD_OPCODE_READ :
+                         I2C_GENI_M_CMD_OPCODE_WRITE, params,
+                         msg->read ? NULL : msg->data, msg->read ? msg->data : NULL,
+                         msg->length, start, timeout);
+        if (status)
+            break;
+        bus->i2c_held = hold;
+    }
+    if (status)
+        (void)release_lines(bus);
+    bus->busy = false;
+    return status;
+}
+
+int CrGeniI2cTransfer(struct CrGeni *bus, const struct CrI2cMessage *messages,
+                      size_t count, uint32_t timeout_us)
+{ return i2c_transfer(bus, messages, count, timeout_us, true); }
+int CrGeniI2cStep(struct CrGeni *bus, const struct CrI2cMessage *message,
+                  bool stop, uint32_t timeout_us)
+{ return i2c_transfer(bus, message, 1, timeout_us, stop); }
+
+int CrGeniSpiTransfer(struct CrGeni *bus,
+                      const struct CrSpiSegment *segments, size_t count,
+                      uint32_t timeout_us)
+{
+    int status = validate_bus(bus, CR_GENI_SPI);
+    if (status)
+        return status;
+    if (!segments || !count || count > 32 || timeout_us > 1000000U)
+        return CR_BUS_INVALID;
+    for (size_t i = 0; i < count; ++i)
+        if ((!segments[i].tx && !segments[i].rx) || !segments[i].length ||
+            segments[i].length > MAX_TRANSFER_BYTES || segments[i].delay_us > 1000U)
+            return CR_BUS_INVALID;
+    if (rd(bus, GENI_SE_STATUS) & GENI_SE_STATUS_M_GENI_CMD_ACTIVE)
+        return CR_BUS_BUSY;
+    uint64_t start = bus->io.now_us(bus->io.context);
+    uint32_t timeout = timeout_us ? timeout_us : DEFAULT_TIMEOUT_US;
+    bus->busy = true;
+    bus->cs_asserted = true;
+    status = command(bus, SPI_GENI_M_CMD_OPCODE_CS_ASSERT, 0, NULL, NULL, 0,
+                     start, timeout);
+    for (size_t i = 0; !status && i < count; ++i) {
+        const struct CrSpiSegment *seg = &segments[i];
+        uint32_t opcode = (seg->tx ? SPI_GENI_M_CMD_OPCODE_TX_ONLY : 0U) |
+                          (seg->rx ? SPI_GENI_M_CMD_OPCODE_RX_ONLY : 0U);
+        status = command(bus, opcode, SPI_GENI_M_CMD_PARAM_FRAGMENTATION,
+                         seg->tx, seg->rx, seg->length, start, timeout);
+        if (!status && seg->delay_us) {
+            /* Protocol CS hold is required even if completion used the last
+             * part of the deadline. Its separately bounded maximum is 1 ms. */
+            bus->io.delay_us(bus->io.context, seg->delay_us);
+            if (expired(bus, start, timeout))
+                status = CR_BUS_TIMEOUT;
+        }
+    }
+    int release = release_lines(bus);
+    if (!status)
+        status = release;
+    bus->busy = false;
+    return status;
+}
+
+int CrGeniQuiesce(struct CrGeni *bus)
+{
+    int status;
+    if (!bus)
+        return CR_BUS_INVALID;
+    if (!bus->initialized)
+        return 0;
+    if (bus->busy)
+        return CR_BUS_BUSY;
+    status = release_lines(bus);
+    if (status)
+        return status;
+    wr(bus, GENI_SE_M_IRQ_CLEAR, UINT32_MAX);
+    wr(bus, GENI_SE_S_IRQ_CLEAR, UINT32_MAX);
+    if (bus->config.protocol == CR_GENI_SPI) {
+        for (size_t i = 0; i < ARRAY_COUNT(spi_saved); ++i)
+            wr(bus, spi_saved[i], bus->saved[ARRAY_COUNT(common_saved) + i]);
+    } else {
+        wr(bus, I2C_GENI_SE_SCL_COUNTERS, bus->saved[ARRAY_COUNT(common_saved)]);
+    }
+    /* IRQ_EN is restored last, after all local status has been cleared. */
+    for (size_t i = 0; i < ARRAY_COUNT(common_saved); ++i)
+        wr(bus, common_saved[i], bus->saved[i]);
+    bus->initialized = false;
+    return 0;
+}
