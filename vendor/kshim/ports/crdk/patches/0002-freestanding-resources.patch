+#define GENI_SE_M_COMMON_IRQ_EN                                                \
+  (KGENI_MASK(6, 1) | GENI_SE_M_IRQ_IO_DATA_DEASSERT |                            \
+   GENI_SE_M_IRQ_IO_DATA_ASSERT | GENI_SE_M_IRQ_RX_FIFO_RD_ERR |               \
