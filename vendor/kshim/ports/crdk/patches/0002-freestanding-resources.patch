+
+/* GENI SE protocol types (GENI_FW_REVISION_RO[15:8]) */
+typedef enum {
+  GENI_SE_PROTO_NONE = 0,
+  GENI_SE_PROTO_SPI  = 1,
+  GENI_SE_PROTO_UART = 2,
