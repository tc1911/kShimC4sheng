+    GENI_SE_M_IRQ_CMD_FAILURE | GENI_SE_M_IRQ_RX_FIFO_RD_ERR | \
+    GENI_SE_M_IRQ_RX_FIFO_WR_ERR | GENI_SE_M_IRQ_TX_FIFO_RD_ERR | \
