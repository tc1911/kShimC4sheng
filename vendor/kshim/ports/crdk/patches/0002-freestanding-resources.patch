+/* SPDX-License-Identifier: MIT */
+#pragma once
+#include <Library/cr_geni.h>
+/* Explicit FIFO polling mode. Clock and pin ownership belongs to the caller. */
+struct CrDebugUartPoll {
+    struct CrIo io;
+    uintptr_t base;
+    size_t size;
+    uint32_t timeout_us, rx_word;
+    uint32_t saved[21], saved_rx_command;
+    uint8_t tx_depth, rx_depth, rx_bytes;
+    bool initialized, poisoned, claimed, inherited_rx;
+};
+int CrDebugUartPollInit(struct CrDebugUartPoll *uart);
+int CrDebugUartPollWrite(struct CrDebugUartPoll *uart, const void *data, size_t length);
+int CrDebugUartPollRead(struct CrDebugUartPoll *uart, uint8_t *byte);
+/* Restore inherited configuration only after both sequencers are idle.
+ * A timeout retains ownership; this call can retry after late completion. */
+int CrDebugUartPollQuiesce(struct CrDebugUartPoll *uart);
diff --git a/Include/Library/cr_geni.h b/Include/Library/cr_geni.h
new file mode 100644
index 0000000..e6a7c69
--- /dev/null
+++ b/Include/Library/cr_geni.h
@@ -0,0 +1,84 @@
+/* SPDX-License-Identifier: MIT */
+#pragma once
+
+#include <oskal/cr_stdint.h>
+
+/* All APIs run on the boot CPU. They do not configure GIC, DMA, or firmware. */
+enum CrIoResult {
+    CR_BUS_OK = 0,
+    CR_BUS_IO = -5,
+    CR_BUS_AGAIN = -11,
+    CR_BUS_BUSY = -16,
+    CR_BUS_INVALID = -22,
+    CR_BUS_UNSUPPORTED = -95,
+    CR_BUS_TIMEOUT = -110,
+    CR_BUS_NACK = -121
+};
+
+struct CrIo {
+    void *context;
+    uint32_t (*read32)(void *context, uintptr_t address);
+    void (*write32)(void *context, uintptr_t address, uint32_t value);
+    uint64_t (*now_us)(void *context);
+    void (*delay_us)(void *context, uint32_t us);
+};
+
+enum CrGeniProtocol { CR_GENI_SPI = 1, CR_GENI_I2C = 3 };
+
+struct CrGeniConfig {
+    uintptr_t base;
+    size_t size; /* Complete mapped SE resource; at least 0xe34 bytes. */
+    enum CrGeniProtocol protocol;
+    uint32_t source_hz;
+    uint32_t speed_hz;
+    uint8_t clock_index; /* Verified GCC DFS index; zero for a normal RCG. */
+    uint8_t spi_mode;    /* CPHA bit 0, CPOL bit 1; 8-bit MSB-first transfers. */
+    uint8_t chip_select;
+};
+
+#define CR_GENI_SAVED_REGS 26
+/* Zero-initialize before first init; config is for QUPv3, SPI oversampling 1. */
+struct CrGeni {
+    struct CrIo io;
+    struct CrGeniConfig config;
+    uint32_t saved[CR_GENI_SAVED_REGS];
+    uint8_t tx_depth, rx_depth;
+    bool initialized, busy, poisoned, i2c_held, cs_asserted;
+};
+
+struct CrI2cMessage {
+    uint16_t address;
+    bool read;
+    uint8_t *data;
+    size_t length;
+};
+
+struct CrSpiSegment {
+    const uint8_t *tx;
+    uint8_t *rx;
+    size_t length;
+    uint16_t delay_us; /* Hold CS after this segment, including the final one; <= 1000. */
+};
+
+/* NULL on non-AArch64 hosts. Native MMIO never probes arbitrary addresses. */
+const struct CrIo *CrIoDefault(void);
+bool CrIoValid(const struct CrIo *io);
+int CrGeniInit(struct CrGeni *bus,
+                       const struct CrGeniConfig *config,
+                       const struct CrIo *io);
+/* Adapter API for descriptor lists with explicit STOP boundaries. The caller
+ * owns the controller lease across all steps, and must quiesce on exit. */
+int CrGeniI2cStep(struct CrGeni *bus, const struct CrI2cMessage *message,
+                  bool stop, uint32_t timeout_us);
+/* timeout_us applies to the complete message; zero selects 20 ms.
+ * Recovery uses bounded 1 ms cancel/abort/release phases. Failed transfers may
+ * modify rx buffers.
+ * I2C emits STOP only after the final message. SPI holds CS across segments. */
+int CrGeniI2cTransfer(struct CrGeni *bus,
+                      const struct CrI2cMessage *messages, size_t count,
+                      uint32_t timeout_us);
+int CrGeniSpiTransfer(struct CrGeni *bus,
+                      const struct CrSpiSegment *segments, size_t count,
+                      uint32_t timeout_us);
+/* Must succeed before handing the SE to UEFI; restores saved SE configuration. */
+int CrGeniQuiesce(struct CrGeni *bus);
