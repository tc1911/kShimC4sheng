+#define GENI_SE_RX_WATERMARK_REG 0x810
+#define GENI_SE_RX_RFR_WATERMARK_REG 0x814
+#define GENI_SE_IOS 0x908
+#define GENI_SE_DMA_TX_IRQ_STAT 0xc40
+#define GENI_SE_DMA_TX_IRQ_CLR 0xc44
+#define GENI_SE_DMA_TX_FSM_RST 0xc58
+#define GENI_SE_DMA_RX_IRQ_STAT 0xd40
+#define GENI_SE_DMA_RX_IRQ_CLR 0xd44
+#define GENI_SE_DMA_RX_FSM_RST 0xd58
+#define GENI_SE_GSI_EVENT_EN 0xe18
+#define GENI_SE_IRQ_EN 0xe1c
+#define GENI_SE_HW_PARAM_0 0xe24
+#define GENI_SE_HW_PARAM_1 0xe28
+#define GENI_SE_DMA_GENERAL_CFG 0xe30
+
+/* GENI_SE_FORCE_DEFAULT_REG fields */
+#define GENI_SE_FORCE_DEFAULT KGENI_BIT(0)
+
+/* GENI_SE_OUTPUT_CTRL fields */
+#define GENI_SE_DEFAULT_IO_OUTPUT_CTRL_MSK KGENI_MASK(6, 0)
