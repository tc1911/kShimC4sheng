diff --git a/Library/CmdDBLib/cmddb_bounded.c b/Library/CmdDBLib/cmddb_bounded.c
new file mode 100644
index 0000000..c226706
--- /dev/null
+++ b/Library/CmdDBLib/cmddb_bounded.c
@@ -0,0 +1,65 @@
+/* Copyright (c) 2025-2026 Project Aloha Authors and Kancy Joe.
+ * SPDX-License-Identifier: MIT */
+#include <Library/cr_resources.h>
+#include "../GeniSeLib/resource_io.h"
+static uint16_t db16(const struct CrIo *io, uintptr_t address)
+{
+    return (uint16_t)(read_io(io, address & ~(uintptr_t)3) >> ((address & 2U) * 8U));
+}
+
+int CrCmdDbLookup(const struct CrIo *io, uintptr_t base,
+                                size_t size, const char *name, uint32_t *address)
+{
+    uint32_t wanted[2] = {0, 0};
+    size_t length = 0;
+    if (!CrIoValid(io) || !name || !address)
+        return CR_BUS_INVALID;
+    while (length < 8 && name[length]) {
+        wanted[length / 4U] |= (uint32_t)(uint8_t)name[length] << ((length % 4U) * 8U);
+        ++length;
+    }
+    if (!length || (length == 8 && name[8]))
+        return CR_BUS_INVALID;
+    /* Both board profiles use a bounded 32-bit physical RAM region. */
+    if (base == 0 || (base & 3U) || size < CMD_DB_HEADER_SIZE ||
+        size > CMD_DB_MAX_SIZE || base > UINTPTR_MAX - size ||
+        read_io(io, (uintptr_t)base + 4U) != CMD_DB_MAGIC)
+        return CR_BUS_INVALID;
+    for (unsigned slave = 0; slave < 8; ++slave) {
+        uintptr_t header = (uintptr_t)base + 8U + slave * 16U;
+        unsigned slave_id = db16(io, header);
+        if (!slave_id)
+            continue;
+        uint32_t offset = db16(io, header + 2U);
+        uint32_t count = db16(io, header + 6U);
+        uint32_t bytes = size - CMD_DB_HEADER_SIZE;
+        if ((offset & 3U) || offset > bytes || count > (bytes - offset) / 24U)
+            return CR_BUS_INVALID;
+        for (uint32_t i = 0; i < count; ++i) {
+            uintptr_t entry = (uintptr_t)base + CMD_DB_HEADER_SIZE + offset + i * 24U;
+            if (read_io(io, entry) != wanted[0] || read_io(io, entry + 4U) != wanted[1])
+                continue;
+            uint32_t result = read_io(io, entry + 16U);
+            if (!result || (result & 3U) || ((result >> 16) & 7U) != slave_id)
+                return CR_BUS_INVALID;
+            uint32_t aux_offset = db16(io, header + 4U);
+            uint32_t aux_length = db16(io, entry + 20U);
+            uint32_t aux_entry_offset = db16(io, entry + 22U);
+            if (aux_offset > bytes || aux_entry_offset > bytes - aux_offset ||
+                aux_length > bytes - aux_offset - aux_entry_offset)
+                return CR_BUS_INVALID;
+            *address = result;
+            return 0;
+        }
+    }
+    return CR_BUS_UNSUPPORTED;
+}
+
+int CrCmdDbLookupDictionary(const struct CrIo *io, uintptr_t dictionary,
+                        const char *name, uint32_t *address)
+{
+    if (!CrIoValid(io) || !dictionary || (dictionary & 3U) || dictionary > UINTPTR_MAX - 8U)
+        return CR_BUS_INVALID;
+    return CrCmdDbLookup(io, read_io(io, dictionary), read_io(io, dictionary + 4U),
+                                name, address);
+}
