+/* Copyright (c) 2025-2026 Project Aloha Authors and Kancy Joe.
+ * SPDX-License-Identifier: MIT */
+#include <Library/cr_resources.h>
+#include "../GeniSeLib/resource_io.h"
+static bool valid(const struct CrQupContext *p)
+{
+    if (!p || !p->board || !CrIoValid(&p->io)) return false;
+    const struct CrQupResources *r = p->board;
+    return r->rsc_base && !(r->rsc_base & 3) && r->rsc_size >= 16 &&
+        r->rsc_base <= UINTPTR_MAX - r->rsc_size && r->drv_id <= 4 &&
+        r->active_count && r->active_count <= 32 &&
+        r->active_offset <= 32 - r->active_count && !(r->tcs_offset & 3) &&
+        r->tcs_offset <= r->rsc_size &&
+        (r->active_offset + r->active_count) * TCS_STRIDE <= r->rsc_size - r->tcs_offset;
+}
+static uint32_t tcs_control_offset(const struct CrQupContext *p)
+{
+    return p->rsc_major == 2 ? 0x14U : 0x24U;
+}
+static uint32_t tcs_command_offset(const struct CrQupContext *p)
+{
+    return p->rsc_major == 2 ? 0x30U : 0x34U;
+}
+static uintptr_t tcs_address(const struct CrQupContext *p)
+{
+    return (p->board->rsc_base + p->board->tcs_offset) + p->tcs_slot * TCS_STRIDE;
+}
+
+/* Only claim an idle, untriggered active TCS in the supplied DRV with no pending IRQ.
+ * The sleep/wake/control TCSes and other DRVs are never touched. */
+int CrRpmhPollClaim(struct CrQupContext *p)
+{
+    if (!valid(p)) return CR_BUS_INVALID;
+    if (p->tcs_claimed || p->tcs_pending) return CR_BUS_BUSY;
+    p->rsc_major = (uint8_t)(rd(p, p->board->rsc_base) >> 16);
+    if (p->rsc_major != 2 && p->rsc_major != 3)
+        return CR_BUS_UNSUPPORTED;
+    uint32_t config = rd(p, p->board->rsc_base + 0xcU);
+    unsigned commands = (config >> 27) & 0x1fU;
+    unsigned count = (config >> (6U * p->board->drv_id)) & 0x3fU;
+    if (!commands || commands > 16 || count < p->board->active_offset + p->board->active_count || count > 32)
+        return CR_BUS_UNSUPPORTED;
+    for (unsigned slot = p->board->active_offset; slot < p->board->active_offset + p->board->active_count; ++slot) {
+        p->tcs_slot = (uint8_t)slot;
+        uintptr_t base = tcs_address(p);
+        uint32_t control = tcs_control_offset(p);
+        uint32_t command = tcs_command_offset(p);
+        if (!rd(p, base + control + 4U) ||
+            (rd(p, base + control) & TCS_TRIGGER) ||
+            (rd(p, (p->board->rsc_base + p->board->tcs_offset) + 4U) & CR_RESOURCE_BIT(slot)))
+            continue;
+        p->saved_tcs[0] = rd(p, base + control);
+        p->saved_tcs[1] = rd(p, base + control - 4U);
+        p->saved_tcs[2] = rd(p, base + control + 8U);
+        p->saved_tcs[3] = rd(p, base + command);
+        p->saved_tcs[4] = rd(p, base + command + 4U);
+        p->saved_tcs[5] = rd(p, base + command + 8U);
+        p->saved_tcs[6] = rd(p, (p->board->rsc_base + p->board->tcs_offset)) & CR_RESOURCE_BIT(slot);
+        p->tcs_claimed = true;
+        return 0;
+    }
+    return CR_BUS_BUSY;
+}
+
+static int rpmh_stop(struct CrQupContext *p)
+{
+    uintptr_t control = tcs_address(p) + tcs_control_offset(p);
+    /* RSC requires clearing trigger first, then AMC mode in a second write. */
+    uint32_t value = rd(p, control) & ~TCS_TRIGGER;
+    wr(p, control, value);
+    int status = wait_bits(p, control, TCS_TRIGGER, 0);
+    if (status)
+        return status;
+    wr(p, control, value & ~TCS_ENABLE);
+    return wait_bits(p, control, TCS_TRIGGER | TCS_ENABLE, 0);
+}
+
+int CrRpmhPollRestore(struct CrQupContext *p)
+{
+    if (!valid(p)) return CR_BUS_INVALID;
+    uintptr_t base = tcs_address(p);
+    uint32_t control = tcs_control_offset(p), command = tcs_command_offset(p);
+    int status;
+    if (!p->tcs_claimed)
+        return 0;
+    if (p->tcs_pending)
+        return CR_BUS_BUSY;
+    status = rpmh_stop(p);
+    if (status)
+        return status;
+    wr(p, base + control + 8U, 0);
+    wr(p, base + command, p->saved_tcs[3]);
+    wr(p, base + command + 4U, p->saved_tcs[4]);
+    wr(p, base + command + 8U, p->saved_tcs[5]);
+    wr(p, base + control - 4U, p->saved_tcs[1]);
+    wr(p, base + control + 8U, p->saved_tcs[2]);
+    wr(p, base + control, p->saved_tcs[0]);
+    rmw(p, (p->board->rsc_base + p->board->tcs_offset), CR_RESOURCE_BIT(p->tcs_slot), p->saved_tcs[6]);
+    p->tcs_claimed = false;
+    return 0;
+}
+
+int CrRpmhPollComplete(struct CrQupContext *p)
+{
+    if (!valid(p) || !p->tcs_claimed || !p->tcs_pending) return CR_BUS_INVALID;
+    uintptr_t base = tcs_address(p);
+    uint32_t command = tcs_command_offset(p);
+    uint32_t bit = CR_RESOURCE_BIT(p->tcs_slot);
+    int status = wait_bits(p, (p->board->rsc_base + p->board->tcs_offset) + 4U, bit, bit);
+    if (status)
+        return status; /* Keep ownership; a late completion must not be reused. */
+    uint32_t completed = rd(p, base + command + 12U);
+    if ((completed & (CR_RESOURCE_BIT(8) | CR_RESOURCE_BIT(16))) != (CR_RESOURCE_BIT(8) | CR_RESOURCE_BIT(16)))
+        status = CR_BUS_IO;
+    int stopped = rpmh_stop(p);
+    if (stopped)
+        return stopped;
+    wr(p, (p->board->rsc_base + p->board->tcs_offset) + 8U, bit);
+    p->tcs_pending = false;
+    int restored = CrRpmhPollRestore(p);
+    return status ? status : restored;
+}
+
+int CrRpmhPollWrite(struct CrQupContext *p, uint32_t address, uint32_t value)
+{
+    if (!valid(p) || (address & 3)) return CR_BUS_INVALID;
+    if (p->tcs_pending) return CR_BUS_BUSY;
+    int status;
+    if (!p->tcs_claimed) {
+        status = CrRpmhPollClaim(p);
+        if (status)
+            return status;
+    }
+    uintptr_t base = tcs_address(p);
+    uint32_t control = tcs_control_offset(p), command = tcs_command_offset(p);
+    if (((address >> 16) & 7U) != 4U)
+        return CR_BUS_INVALID;
+    /* Completion status remains readable with the interrupt output masked. */
+    rmw(p, (p->board->rsc_base + p->board->tcs_offset), CR_RESOURCE_BIT(p->tcs_slot), 0);
+    status = rpmh_stop(p);
+    if (status)
+        return status;
+    wr(p, base + control + 8U, 0);
+    wr(p, base + command, 8U | CR_RESOURCE_BIT(8) | CR_RESOURCE_BIT(16));
+    wr(p, base + command + 4U, address);
+    wr(p, base + command + 8U, value);
+    wr(p, base + control - 4U, 1);
+    wr(p, base + control + 8U, 1);
+    wr(p, base + control, TCS_ENABLE);
+    status = wait_bits(p, base + control, TCS_ENABLE, TCS_ENABLE);
+    if (status)
+        return status;
+    p->tcs_pending = true;
+    wr(p, base + control, TCS_ENABLE | TCS_TRIGGER);
+    return CrRpmhPollComplete(p);
+}
