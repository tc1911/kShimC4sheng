diff --git a/Library/DisplayLib/splash.c b/Library/DisplayLib/splash.c
new file mode 100644
index 0000000..103ac0b
--- /dev/null
+++ b/Library/DisplayLib/splash.c
@@ -0,0 +1,537 @@
+/* SPDX-License-Identifier: MIT */
+#include <Library/cr_splash.h>
+#include <oskal/cr_string.h>
+struct scan { uint32_t src, xy, out, out_xy, addr, stride, format, unpack, op, secure, rect; };
+static uint32_t rd(const struct CrSplashResources *r, const struct CrIo *io, uint32_t offset)
+{ return io->read32(io->context, r->base + offset); }
+static bool within(uint64_t base, uint64_t size, uint64_t a, uint64_t s)
+{ return size && s && base <= UINT64_MAX - size && a >= base && s <= size && a - base <= size - s; }
+static void snapshot(const struct CrSplashResources *r, const struct CrIo *io, unsigned p, struct scan *s)
+{
+    uint32_t base = r->pipe[p];
+    *s = (struct scan){.src = rd(r, io, base), .xy = rd(r, io, base + 8),
+        .out = rd(r, io, base + 12), .out_xy = rd(r, io, base + 16),
+        .addr = rd(r, io, base + 20), .stride = rd(r, io, base + 36),
+        .format = rd(r, io, base + 48), .unpack = rd(r, io, base + 52),
+        .op = rd(r, io, base + 56), .secure = rd(r, io, base + 112),
+        .rect = rd(r, io, base + 0x170)};
+}
+struct routing { unsigned mask; int mixer[10]; uint32_t out[10], op[10]; };
+static int active_legacy(const struct CrSplashResources *r, const struct CrIo *io, struct routing *route)
+{
+    static const unsigned shift[] = {0, 3, 6, 26, 18, 21};
+    static const unsigned ext_shift[] = {0, 2, 4, 6, 16, 18};
+    cr_memset(route, 0, sizeof(*route));
+    for (unsigned p = 0; p < 10; ++p) route->mixer[p] = -1;
+    unsigned mixers = 0;
+    for (unsigned c = 0; c < r->ctl_count; ++c) {
+        unsigned base = r->ctl[c];
+        if (!rd(r, io, base + 0xf4) && !(rd(r, io, base + 0x14) & 15)) continue;
+        for (unsigned m = 0; m < r->mixer_count; ++m) {
+            uint32_t layer = rd(r, io, base + (m == 5 ? 0x24 : m * 4));
+            uint32_t ext = rd(r, io, base + 0x40 + m * 4);
+            uint32_t ext2 = rd(r, io, base + 0x70 + m * 4);
+            uint32_t ext3 = rd(r, io, base + 0xa0 + m * 4);
+            if ((layer & ((0x1ffU << 9) | (7U << 29) | (1U << 25))) ||
+                (ext & ~0x50055U) || (ext2 & ~0xffU) || ext3) return CR_BUS_UNSUPPORTED;
+            for (unsigned id = 0; id < 8; ++id) {
+                bool used = id < 6 ? ((layer >> shift[id]) & 7) || ((ext >> ext_shift[id]) & 1)
+                                  : ((ext2 >> ((id - 6) * 4)) & 15);
+                if (!used) continue;
+                unsigned p;
+                for (p = 0; p < r->pipe_count; ++p) if (r->pipe_id[p] == id) break;
+                /* Reject an unlisted active pipe, overlapping composition,
+                 * and a single pipe fanned out to multiple mixers. */
+                if (p == r->pipe_count || route->mixer[p] >= 0 || (mixers & (1U << m)))
+                    return CR_BUS_UNSUPPORTED;
+                route->mask |= 1U << p; mixers |= 1U << m;
+                route->mixer[p] = m;
+                route->out[p] = rd(r, io, r->mixer[m] + 4);
+                route->op[p] = rd(r, io, r->mixer[m]) & (1U << 31);
+            }
+        }
+    }
+    return 0;
+}
+static int format(const struct scan *s, enum CrSplashFormat *f, unsigned *bytes)
+{
+    /* Linear, tightly packed, interleaved RGB only; no rotate/YUV/DX/solid-fill. */
+    uint32_t v = s->format & ~(1U << 8);
+    if (v == 0x22216 && s->unpack == 0x00010002 && !(s->format & (1U << 8))) {
+        *f = CR_SPLASH_RGB565; *bytes = 2; return 0;
+    }
+    if (v != 0x236ff) return -1;
+    *bytes = 4;
+    if (s->unpack == 0x03020001) *f = (s->format & 256) ? CR_SPLASH_ARGB8888 : CR_SPLASH_XRGB8888;
+    else if (s->unpack == 0x03010002) *f = (s->format & 256) ? CR_SPLASH_ABGR8888 : CR_SPLASH_XBGR8888;
+    else return -1;
+    return 0;
+}
+/* ---- DPU12/DPU13 shared LM routing discovery (routing only, no framebuffer decode) ---- */
+
+#define REC_PIPE_MASK  0x000f003fu  /* DMA bits 0..5, VIG bits 16..19 */
+#define REC_BG_OFF     0x14u
+#define REC_OUT_OFF    0x04u
+#define REC_OP_OFF     0x00u
+
+struct rec_lm {
+    uint32_t resource;
+    uint32_t mask;
+    uint32_t stage;
+    uint32_t out;
+    uint32_t op;
+};
+
+struct rec_route {
+    uint32_t ctl_intf;
+    uint32_t pipe_active;
+    uint32_t lm_active;
+    uint32_t mask;
+    uint32_t count;
+    struct rec_lm lm[2];
+};
+
+/* Decode one 8-bit selector byte into its hardware logical pipe ID
+   (0..3 VIG, 4..9 DMA) and the CTL pipe hardware bit. Returns 1 on
+   malformed or unsupported byte. */
+static int rec_byte_map(uint32_t byte, uint32_t *resource, uint32_t *hwbit)
+{
+    uint32_t type = (byte >> 6) & 3u;
+    uint32_t id   = byte & 0x0fu;
+
+    if ((byte & 0x30u) != 0u)          /* bits 4..5 must be RECT0 */
+        return 1;
+    if (type == 0u) {                  /* DMA0..5 => hw pipe 4..9 */
+        if (id > 5u)
+            return 1;
+        *resource = id + 4u;
+        *hwbit    = id;
+        return 0;
+    }
+    if (type == 1u) {                  /* VIG0..3 => hw pipe 0..3 */
+        if (id > 3u)
+            return 1;
+        *resource = id;
+        *hwbit    = 16u + id;
+        return 0;
+    }
+    return 1;
+}
+
+static int active_rec(const struct CrSplashResources *r, const struct CrIo *io,
+                      struct rec_route *route)
+{
+    uint32_t pipe_active, lm_active, supplied = 0u, nlm, i, rec = 0u, intf;
+    uint32_t uhw = 0u, umask = 0u, ucnt = 0u;
+
+    cr_memset(route, 0, sizeof(*route));
+
+    /* Safe primary only: read just the CTL0 control interface dword. */
+    intf = rd(r, io, r->ctl[0] + 0xf4u);
+    if (intf == 0u)
+        return CR_BUS_UNSUPPORTED;
+
+    pipe_active = rd(r, io, r->ctl[0] + 0x12cu);   /* PIPE_ACTIVE */
+    lm_active   = rd(r, io, r->ctl[0] + 0x130u);   /* LM_ACTIVE   */
+
+    /* LM_ACTIVE valid bits are the supplied mixer IDs. */
+    for (i = 0u; i < r->mixer_count; i++)
+        supplied |= 1u << r->mixer_id[i];
+
+    if ((pipe_active & ~REC_PIPE_MASK) != 0u)
+        return CR_BUS_UNSUPPORTED;
+    if ((lm_active & ~supplied) != 0u)
+        return CR_BUS_UNSUPPORTED;
+    if (pipe_active == 0u || lm_active == 0u)
+        return CR_BUS_UNSUPPORTED;
+
+    route->ctl_intf    = intf;
+    route->pipe_active = pipe_active;
+    route->lm_active   = lm_active;
+
+    for (nlm = 0u; nlm < r->mixer_count; nlm++) {
+        uint32_t lm = r->mixer_id[nlm];
+        uint32_t s, chosen_stage = 0u, chosen_mask = 0u, occupied = 0u;
+
+        if ((lm_active & (1u << lm)) == 0u)
+            continue;
+        if (rec >= 2u)                 /* at most two active LMs */
+            return CR_BUS_UNSUPPORTED;
+
+        for (s = 0u; s <= r->stage_count; s++) {
+            uint32_t sel = (s == 0u) ? rd(r, io, r->mixer[nlm] + REC_BG_OFF)
+                                     : rd(r, io, r->mixer[nlm] + r->stage[s - 1u] + 4u);
+            uint32_t b, cnt = 0u, smask = 0u;
+
+            if ((sel >> 16) != 0u)     /* selector is 16-bit */
+                return CR_BUS_UNSUPPORTED;
+
+            for (b = 0u; b < 2u; b++) {
+                uint32_t byte = (sel >> (b * 8u)) & 0xffu;
+                uint32_t res, hwbit, p;
+
+                if (byte == 0xc0u)     /* 0xc0 byte means empty */
+                    continue;
+                if (rec_byte_map(byte, &res, &hwbit) != 0)
+                    return CR_BUS_UNSUPPORTED;
+                if ((pipe_active & (1u << hwbit)) == 0u)
+                    return CR_BUS_UNSUPPORTED;
+                for (p = 0u; p < r->pipe_count; p++)
+                    if (r->pipe_id[p] == res)
+                        break;
+                if (p >= r->pipe_count)
+                    return CR_BUS_UNSUPPORTED;
+                if ((smask & (1u << p)) != 0u)   /* duplicate within LM */
+                    return CR_BUS_UNSUPPORTED;
+
+                smask |= (1u << p);
+                uhw   |= (1u << hwbit);
+                cnt++;
+            }
+
+            if (cnt == 0u)
+                continue;
+            if (occupied != 0u)        /* all sources in one occupied slot */
+                return CR_BUS_UNSUPPORTED;
+
+            occupied     = 1u;
+            chosen_stage = s;          /* BG slot 0, FG slot 1+s */
+            chosen_mask  = smask;
+        }
+
+        if (occupied == 0u)            /* no active LM may be empty */
+            return CR_BUS_UNSUPPORTED;
+
+        route->lm[rec].resource = nlm;
+        route->lm[rec].mask     = chosen_mask;
+        route->lm[rec].stage    = chosen_stage;
+        route->lm[rec].out      = rd(r, io, r->mixer[nlm] + REC_OUT_OFF);
+        route->lm[rec].op       = rd(r, io, r->mixer[nlm] + REC_OP_OFF) & 0x80000000u;
+
+        umask |= chosen_mask;
+        rec++;
+    }
+
+    if (rec == 0u || rec > 2u)
+        return CR_BUS_UNSUPPORTED;
+
+    /* Union of pipe hardware bits must exactly cover PIPE_ACTIVE. */
+    if (uhw != pipe_active)
+        return CR_BUS_UNSUPPORTED;
+
+    /* Union of resource masks must be at most two bits. */
+    {
+        uint32_t t = umask;
+        while (t != 0u) {
+            ucnt += t & 1u;
+            t >>= 1u;
+        }
+    }
+    if (ucnt > 2u)
+        return CR_BUS_UNSUPPORTED;
+
+    route->mask  = umask;
+    route->count = rec;
+    return 0;
+}
+struct rec_scan { struct scan s; uint32_t img, current, odx[4]; };
+
+static void snapshot_rec(const struct CrSplashResources *r, const struct CrIo *io, unsigned p, struct rec_scan *t)
+{
+    cr_memset(t, 0, sizeof(*t));
+    if (!r->sspp_rec_separated) {
+        snapshot(r, io, p, &t->s);
+        return;
+    }
+    t->s.rect = rd(r, io, r->pipe[p] + 0x10);
+    uint32_t base = r->pipe[p] + 0x1000;
+    t->s.format = rd(r, io, base + 0x00);
+    t->s.unpack = rd(r, io, base + 0x04);
+    t->s.op = rd(r, io, base + 0x08);
+    t->img = rd(r, io, base + 0x10);
+    t->s.src = rd(r, io, base + 0x14);
+    t->s.xy = rd(r, io, base + 0x18);
+    t->s.out = rd(r, io, base + 0x1c);
+    t->s.out_xy = rd(r, io, base + 0x20);
+    t->odx[0] = rd(r, io, base + 0x30);
+    t->odx[1] = rd(r, io, base + 0x34);
+    t->odx[2] = rd(r, io, base + 0x38);
+    t->odx[3] = rd(r, io, base + 0x3c);
+    t->s.addr = rd(r, io, base + 0x4c);
+    t->s.stride = rd(r, io, base + 0x5c);
+    t->current = rd(r, io, base + 0x64);
+    t->s.secure = rd(r, io, base + 0x74);
+}
+static int read_rec(const struct CrSplashResources *r, const struct CrIo *io,
+                    struct CrSplash *fb)
+{
+    struct rec_route route, again;
+    struct rec_scan scans[2], reed[2];
+    const struct scan *part[2];
+    unsigned bpp[2], npipe = 0, i, j, count, left = 0, right = 1;
+    unsigned lm_left = 0;
+    enum CrSplashFormat formats[2];
+    uint32_t xo[2], pipes[2], lmw[2], lmh[2], cw, ch;
+    struct CrSplash out;
+    bool shared = false;
+    int ret;
+
+    cr_memset(&route, 0, sizeof(route));
+    cr_memset(&again, 0, sizeof(again));
+    cr_memset(scans, 0, sizeof(scans));
+    cr_memset(reed, 0, sizeof(reed));
+    cr_memset(&out, 0, sizeof(out));
+
+    ret = active_rec(r, io, &route);
+    if (ret)
+        return ret;
+
+    count = route.count;
+    if (count != 1 && count != 2)
+        return CR_BUS_UNSUPPORTED;
+    for (j = 0; j < 32; j++) {
+        if (route.mask & (1u << j)) {
+            if (npipe == 2)
+                return CR_BUS_UNSUPPORTED;
+            pipes[npipe++] = j;
+        }
+    }
+    if (npipe != count)
+        return CR_BUS_UNSUPPORTED;
+
+    for (i = 0; i < count; i++) {
+        lmw[i] = route.lm[i].out & 0xffff;
+        lmh[i] = route.lm[i].out >> 16;
+        if (lmw[i] == 0 || lmw[i] > 8192 || lmh[i] == 0 || lmh[i] > 8192)
+            return CR_BUS_INVALID;
+    }
+    if (count == 1) {
+        if (route.lm[0].op != 0)
+            return CR_BUS_UNSUPPORTED;
+    } else {
+        uint32_t m0 = route.lm[0].mask, m1 = route.lm[1].mask;
+        bool p0 = m0 && (m0 & (m0 - 1)) == 0;
+        bool p1 = m1 && (m1 & (m1 - 1)) == 0;
+
+        if (route.lm[0].op == route.lm[1].op || lmh[0] != lmh[1])
+            return CR_BUS_UNSUPPORTED;
+        lm_left = route.lm[0].op ? 1 : 0;
+        if (p0 && p1) {
+            if (m0 & m1)
+                return CR_BUS_UNSUPPORTED;
+        } else if (m0 && m0 == m1) {
+            if (route.lm[0].stage != route.lm[1].stage)
+                return CR_BUS_UNSUPPORTED;
+            shared = true;
+        } else {
+            return CR_BUS_UNSUPPORTED;
+        }
+    }
+
+    ch = lmh[0];
+    cw = (count == 1) ? lmw[0] : lmw[0] + lmw[1];
+    if (cw > 8192)
+        return CR_BUS_INVALID;
+
+    for (i = 0; i < npipe; i++) {
+        struct rec_scan *s = &scans[i];
+        uint32_t w, h, sx, stride;
+        uint64_t saddr, plen;
+        unsigned b = 0;
+
+        snapshot_rec(r, io, pipes[i], s);
+        if (s->s.rect || s->s.secure ||
+            (r->sspp_rec_separated &&
+             (s->odx[0] || s->odx[1] || s->odx[2] || s->odx[3])) ||
+            (s->s.op & ~((1u << 31) | (1u << 4))))
+            return CR_BUS_UNSUPPORTED;
+        if (s->s.src != s->s.out || (s->s.xy >> 16) || (s->s.out_xy >> 16) ||
+            (r->sspp_rec_separated &&
+             (s->current != s->s.addr || (s->s.stride >> 16))))
+            return CR_BUS_UNSUPPORTED;
+        if (format(&s->s, &formats[i], &b))
+            return CR_BUS_UNSUPPORTED;
+
+        w = s->s.src & 0xffff;
+        h = s->s.src >> 16;
+        sx = s->s.xy & 0xffff;
+        stride = s->s.stride & 0xffff;
+        if (w == 0 || w > 8192 || h == 0 || h > 8192)
+            return CR_BUS_INVALID;
+        if (h != ch)
+            return CR_BUS_UNSUPPORTED;
+        if ((uint64_t)stride < ((uint64_t)sx + w) * b)
+            return CR_BUS_INVALID;
+        saddr = (uint64_t)s->s.addr + (uint64_t)sx * b;
+        if (saddr > (uint64_t)UINTPTR_MAX || (b && saddr % b))
+            return CR_BUS_INVALID;
+        plen = (uint64_t)stride * (h - 1) + (uint64_t)w * b;
+        if (!within(r->reserved_base, r->reserved_size, saddr, plen))
+            return CR_BUS_INVALID;
+
+        part[i] = &s->s;
+        bpp[i] = b;
+        if (shared) {
+            xo[i] = s->s.out_xy & 0xffff;
+        } else {
+            for (j = 0; j < count; j++) {
+                if (route.lm[j].mask & (1u << pipes[i]))
+                    break;
+            }
+            if (j == count)
+                return CR_BUS_UNSUPPORTED;
+            if (s->s.out_xy != 0 || s->s.out != route.lm[j].out)
+                return CR_BUS_UNSUPPORTED;
+            xo[i] = (j == lm_left) ? 0 : lmw[lm_left];
+        }
+    }
+
+    if (npipe == 2 && xo[0] > xo[1]) {
+        left = 1;
+        right = 0;
+    }
+    if (xo[left] != 0 || part[left]->xy != 0)
+        return CR_BUS_UNSUPPORTED;
+
+    {
+        const struct scan *L = part[left];
+        uint32_t lw = L->src & 0xffff;
+        uint64_t laddr = (uint64_t)L->addr +
+                         (uint64_t)(L->xy & 0xffff) * bpp[left];
+
+        if (npipe == 2) {
+            const struct scan *R = part[right];
+            if (xo[right] != lw || formats[right] != formats[left] ||
+                bpp[right] != bpp[left] ||
+                (R->stride & 0xffff) != (L->stride & 0xffff) ||
+                (R->src >> 16) != (L->src >> 16))
+                return CR_BUS_UNSUPPORTED;
+            if ((uint64_t)R->addr + (uint64_t)(R->xy & 0xffff) * bpp[right] !=
+                laddr + (uint64_t)lw * bpp[left])
+                return CR_BUS_UNSUPPORTED;
+            if ((uint64_t)lw + (R->src & 0xffff) != cw)
+                return CR_BUS_UNSUPPORTED;
+        } else if (lw != cw) {
+            return CR_BUS_UNSUPPORTED;
+        }
+
+        {
+            uint32_t fs = L->stride & 0xffff, fh = L->src >> 16;
+            uint64_t fsz = (uint64_t)fs * fh;
+
+            if ((uint64_t)fs < (uint64_t)cw * bpp[left] ||
+                fsz > (uint64_t)SIZE_MAX || laddr > (uint64_t)UINTPTR_MAX ||
+                (fsz && laddr + fsz - 1 > (uint64_t)UINTPTR_MAX))
+                return CR_BUS_INVALID;
+            if (!within(r->reserved_base, r->reserved_size, laddr, fsz))
+                return CR_BUS_INVALID;
+
+            out.address = (uintptr_t)laddr;
+            out.size = (size_t)fsz;
+            out.width = cw;
+            out.height = fh;
+            out.stride = fs;
+            out.format = formats[left];
+        }
+    }
+
+    for (i = 0; i < npipe; i++) {
+        cr_memset(&reed[i], 0, sizeof(reed[i]));
+        snapshot_rec(r, io, pipes[i], &reed[i]);
+        if (cr_memcmp(&reed[i], &scans[i], sizeof(scans[i])))
+            return CR_BUS_AGAIN;
+    }
+    ret = active_rec(r, io, &again);
+    if (ret)
+        return CR_BUS_AGAIN;
+    if (cr_memcmp(&again, &route, sizeof(route)))
+        return CR_BUS_AGAIN;
+
+    *fb = out;
+    return 0;
+}
+int CrSplashRead(const struct CrSplashResources *r, const struct CrIo *io, struct CrSplash *fb)
+{
+    if (!r || !io || !io->read32 || !fb || !r->base || r->base > UINTPTR_MAX - r->size ||
+        !r->pipe_count || !r->ctl_count || !r->mixer_count || !r->reserved_size) return CR_BUS_INVALID;
+    if (r->sspp_rec_separated && !r->lm_source_select) return CR_BUS_INVALID;
+    bool canoe = r->lm_source_select;
+    if (r->pipe_count > (canoe ? 10 : 8) || r->ctl_count > 8 || r->mixer_count > (canoe ? 8 : 6))
+        return CR_BUS_INVALID;
+    unsigned ids = 0;
+    for (unsigned p = 0; p < r->pipe_count; ++p) {
+        if (r->pipe_id[p] > (canoe ? 9 : 7) || (ids & (1U << r->pipe_id[p])) ||
+            (r->pipe[p] & 3) || !within(0, r->size, r->pipe[p], r->sspp_rec_separated ? 0x1078 : 0x174) ||
+            (r->sspp_rec_separated && (uint64_t)r->pipe[p] + 0x1077 > UINT32_MAX)) return CR_BUS_INVALID;
+        ids |= 1U << r->pipe_id[p];
+    }
+    unsigned ctl_span = canoe ? 0x134 : 0xf8;
+    for (unsigned c = 0; c < r->ctl_count; ++c) {
+        if ((r->ctl[c] & 3) || !within(0, r->size, r->ctl[c], ctl_span)) return CR_BUS_INVALID;
+        if (r->sspp_rec_separated && (uint64_t)r->ctl[c] + 0x133 > UINT32_MAX) return CR_BUS_INVALID;
+    }
+    for (unsigned m = 0; m < r->mixer_count; ++m) {
+        if ((r->mixer[m] & 3) || !within(0, r->size, r->mixer[m], canoe ? 0x18 : 8)) return CR_BUS_INVALID;
+        if (r->sspp_rec_separated && (uint64_t)r->mixer[m] + 0x17 > UINT32_MAX) return CR_BUS_INVALID;
+    }
+    if (canoe) {
+        if (!r->stage_count || r->stage_count > 11) return CR_BUS_INVALID;
+        unsigned mids = 0;
+        for (unsigned m = 0; m < r->mixer_count; ++m) {
+            if (r->mixer_id[m] > 7 || (mids & (1U << r->mixer_id[m]))) return CR_BUS_INVALID;
+            mids |= 1U << r->mixer_id[m];
+        }
+        for (unsigned i = 0; i < r->stage_count; ++i) {
+            if ((r->stage[i] & 3) || r->stage[i] < 0x40) return CR_BUS_INVALID;
+            for (unsigned j = i + 1; j < r->stage_count; ++j)
+                if (r->stage[i] == r->stage[j]) return CR_BUS_INVALID;
+            for (unsigned m = 0; m < r->mixer_count; ++m) {
+                if (!within(0, r->size, (uint64_t)r->mixer[m] + r->stage[i], 8)) return CR_BUS_INVALID;
+                if (r->sspp_rec_separated && (uint64_t)r->mixer[m] + r->stage[i] + 7 > UINT32_MAX) return CR_BUS_INVALID;
+            }
+        }
+    }
+    if (r->lm_source_select) return read_rec(r, io, fb);
+    struct routing route, again;
+    if (active_legacy(r, io, &route) || !route.mask) return CR_BUS_UNSUPPORTED;
+    struct scan scans[2]; unsigned count = 0, pipe[2], bytes = 0;
+    struct CrSplash part[2];
+    for (unsigned p = 0; p < r->pipe_count; ++p) {
+        if (!(route.mask & (1U << p))) continue;
+        if (count == 2) return CR_BUS_UNSUPPORTED;
+        struct scan *s = &scans[count]; snapshot(r, io, p, s);
+        unsigned bpp;
+        if (format(s, &part[count].format, &bpp) || s->src != s->out ||
+            (s->xy >> 16) || s->out_xy || s->out != route.out[p] || s->secure || s->rect ||
+            (s->op & ~((1U << 31) | (1U << 4)))) return CR_BUS_UNSUPPORTED;
+        bytes = bpp; pipe[count] = p;
+        part[count].width = s->src & 0xffff; part[count].height = s->src >> 16;
+        part[count].stride = s->stride & 0xffff;
+        part[count].address = (uint64_t)s->addr + (s->xy & 0xffff) * bpp;
+        if (!part[count].width || !part[count].height || part[count].width > 8192 || part[count].height > 8192 ||
+            part[count].stride < ((s->xy & 0xffff) + part[count].width) * bpp || (part[count].address % bpp)) return CR_BUS_INVALID;
+        part[count].size = (uint64_t)part[count].stride * (part[count].height - 1) + part[count].width * bpp;
+        if (!within(r->reserved_base, r->reserved_size, part[count].address, part[count].size)) return CR_BUS_INVALID;
+        ++count;
+    }
+    if (count == 1 && (route.op[pipe[0]] || scans[0].xy)) return CR_BUS_UNSUPPORTED;
+    if (count == 2) {
+        if (route.op[pipe[0]] == route.op[pipe[1]]) return CR_BUS_UNSUPPORTED;
+        unsigned left = route.op[pipe[0]] ? 1 : 0;
+        if (scans[left].xy) return CR_BUS_UNSUPPORTED;
+        if (left) { struct CrSplash t = part[0]; part[0] = part[1]; part[1] = t; }
+        if (part[0].address + part[0].width * bytes != part[1].address || part[0].height != part[1].height ||
+            part[0].stride != part[1].stride || part[0].format != part[1].format) return CR_BUS_UNSUPPORTED;
+        part[0].width += part[1].width;
+    }
+    if (!count || part[0].width * bytes > part[0].stride) return CR_BUS_UNSUPPORTED;
+    part[0].size = (uint64_t)part[0].stride * part[0].height;
+    if (!within(r->reserved_base, r->reserved_size, part[0].address, part[0].size)) return CR_BUS_INVALID;
+    for (unsigned i = 0; i < count; ++i) {
+        struct scan next; snapshot(r, io, pipe[i], &next);
+        if (cr_memcmp(&next, &scans[i], sizeof(next))) return CR_BUS_AGAIN;
+    }
+    if (active_legacy(r, io, &again) || cr_memcmp(&again, &route, sizeof(route))) return CR_BUS_AGAIN;
+    *fb = part[0];
+    return 0;
+}
