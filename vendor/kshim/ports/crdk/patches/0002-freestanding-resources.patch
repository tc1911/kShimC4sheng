+#define GENI_SE_S_IRQ_STATUS 0x640
+#define GENI_SE_S_IRQ_EN 0x644
+#define GENI_SE_S_IRQ_CLEAR 0x648
+#define GENI_SE_TX_FIFOn 0x700
+#define GENI_SE_RX_FIFOn 0x780
+#define GENI_SE_TX_FIFO_STATUS 0x800
+#define GENI_SE_RX_FIFO_STATUS 0x804
