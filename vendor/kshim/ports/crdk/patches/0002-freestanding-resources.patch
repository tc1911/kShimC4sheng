+#include <Library/cr_resources.h>
+#include "../GeniSeLib/resource_io.h"
+static void gpio_configure(struct CrQupContext *p, unsigned pin, uint32_t config, unsigned value)
+{
+    GpioConfigParams params = {.PinNumber = pin, .OutputEnable = !!(config & CR_RESOURCE_BIT(9)),
+        .FunctionSel = (config >> 2) & 15, .Pull = config & 3,
+        .DriveStrength = (config >> 6) & 7, .OutputValue = value};
+    GpioSetConfig(&p->gpio, &params);
+}
+static void configure_pins(struct CrQupContext *p)
+{
+    const struct CrQupResources *board = p->board;
+    const uintptr_t pins[] = {board->bus_pins[0], board->bus_pins[1], board->irq_pin};
+    for (unsigned i = 0; i < 3; ++i)
+        p->saved_pins[i] = rd(p, pins[i]);
+    p->pins_claimed = true;
+    p->gpio.Io = p->io;
+    p->gpio.PinCount = 5;
+    p->gpio.RegCfg[0] = (GpioConfigRegInfo){.IoRegOffset = 4, .PullMsk = 3,
+        .MuxSelMsk = 15U << 2, .DriveStrengthMsk = 7U << 6,
+        .OutputEnableMsk = CR_RESOURCE_BIT(9), .InputMsk = 1, .OutputMsk = 2};
+    const uintptr_t addresses[] = {board->bus_pins[0], board->bus_pins[1], board->irq_pin,
+                                   board->reset_pin, board->gate_pin};
+    for (unsigned i = 0; i < 5; ++i) {
+        p->gpio.GpioPins[i].PinAddress = addresses[i];
+        p->gpio.GpioPins[i].pRegCfg = &p->gpio.RegCfg[0];
+        p->gpio.GpioPins[i].Reserved = !addresses[i];
+    }
+    /* Both verified bus routes use mux 1, 2 mA, no internal pulls. */
+    gpio_configure(p, 0, board->bus_config[0], GPIO_VALUE_UNCHANGE);
+    gpio_configure(p, 1, board->bus_config[1], GPIO_VALUE_UNCHANGE);
+    gpio_configure(p, 2, 0, GPIO_VALUE_UNCHANGE); /* No pull into an unpowered IC. */
+}
+static void gpio_output(struct CrQupContext *p, uintptr_t pin, bool high,
+                         uint32_t config)
+{
+    gpio_configure(p, pin == p->board->reset_pin ? 3 : 4, config, high ? GPIO_VALUE_HIGH : GPIO_VALUE_LOW);
+}
+
+int CrQupReset(struct CrQupContext *p)
+{
+    if (!p || !p->board || !CrIoValid(&p->io) || !p->i2c.initialized)
+        return CR_BUS_INVALID;
+    gpio_output(p, p->board->reset_pin, false, p->board->reset_config);
+    p->io.delay_us(p->io.context, p->board->reset_low_us);
+    gpio_output(p, p->board->reset_pin, true, p->board->reset_config);
+    return 0;
+}
+
+int CrQupInit(struct CrQupContext *p,
+                           const struct CrIo *io,
+                           const struct CrQupResources *board)
+{
+    int status;
+    uint8_t clock_index = 0;
+    if (!io)
+        io = CrIoDefault();
+    if (!p || !board || !CrIoValid(io) || board->rail_count == 0 ||
+        board->rail_count > 2 || !board->geni || !board->rsc_base ||
+        board->drv_id > 4 || !board->active_count || board->active_count > 32 ||
+        board->active_offset > 32 - board->active_count ||
+        board->tcs_offset > board->rsc_size ||
+        (board->active_offset + board->active_count) * 0x2a0U > board->rsc_size - board->tcs_offset ||
+        !board->source_hz || !board->speed_hz)
+        return CR_BUS_INVALID;
+    if (p->initialized || p->tcs_claimed || p->clocks_claimed || p->i2c.initialized)
+        return CR_BUS_BUSY;
+    *p = (struct CrQupContext){ .io = *io, .board = board,
+                                      .stage = CR_QUP_STAGE_CMD_DB };
+    for (unsigned i = 0; i < board->rail_count; ++i) {
+        status = board->cmd_db_base ?
+            CrCmdDbLookup(io, board->cmd_db_base, board->cmd_db_size,
+                                  board->rails[i].name, &p->rail_addresses[i]) :
+            CrCmdDbLookupDictionary(io, board->cmd_db_dictionary, board->rails[i].name,
+                                 &p->rail_addresses[i]);
+        if (status || ((p->rail_addresses[i] >> 16) & 7U) != 4U ||
+            p->rail_addresses[i] > UINT32_MAX - 8U ||
+            (((p->rail_addresses[i] + 8U) >> 16) & 7U) != 4U)
+            return status ? status : CR_BUS_UNSUPPORTED;
+    }
+    status = CrRpmhPollClaim(p);
+    if (status)
+        return status;
+    p->stage = CR_QUP_STAGE_CLOCK;
+    status = CrClockPollPrepare(p, &clock_index);
+    if (status)
+        goto fail;
+    configure_pins(p);
+    p->stage = CR_QUP_STAGE_GENI;
+    const struct CrGeniConfig config = {
+        .base = board->geni, .size = board->geni_size, .protocol = CR_GENI_I2C,
+        .source_hz = board->source_hz, .speed_hz = board->speed_hz, .clock_index = clock_index
+    };
+    status = CrGeniInit(&p->i2c, &config, io);
+    if (status)
+        goto fail;
+    p->stage = CR_QUP_STAGE_POWER;
+    if (board->gate_pin) {
+        gpio_output(p, board->gate_pin, true, CR_RESOURCE_BIT(9));
+        p->io.delay_us(p->io.context, board->gate_delay_us);
+    }
+    for (unsigned i = 0; i < board->rail_count; ++i) {
+        const struct CrRail *rail = &board->rails[i];
+        uint32_t address = p->rail_addresses[i];
+        if (rail->millivolts) {
+            status = CrRpmhPollWrite(p, address, rail->millivolts);
+            if (status)
+                goto fail;
+        }
+        if (rail->mode) {
+            status = CrRpmhPollWrite(p, address + 8U, rail->mode);
+            if (status)
+                goto fail;
+        }
+        status = CrRpmhPollWrite(p, address + 4U, 1);
+        if (status)
+            goto fail;
+    }
+    /* Pull up IRQ only once the complete power sequence has been ACKed. */
+    gpio_configure(p, 2, board->irq_config, GPIO_VALUE_UNCHANGE);
+    p->stage = CR_QUP_STAGE_RESET;
+    status = CrQupReset(p);
+    if (status)
+        goto fail;
+    p->initialized = true;
+    p->stage = CR_QUP_STAGE_READY;
+    return 0;
+fail:
+    /* A timed-out TCS remains owned until a verified late completion. */
+    (void)CrQupQuiesce(p);
+    return status;
+}
+
+
+int CrQupIrq(struct CrQupContext *p)
+{
+    if (!p || !p->board || !p->initialized)
+        return CR_BUS_INVALID;
+    return (GpioReadInputVal(&p->gpio, 2) != 0) != p->board->irq_active_low;
+}
+
+int CrQupQuiesce(struct CrQupContext *p)
+{
+    int status;
+    if (!p)
+        return CR_BUS_INVALID;
+    if (!CrIoValid(&p->io) || !p->board)
+        return 0;
+    if (p->tcs_pending) {
+        status = CrRpmhPollComplete(p);
+        if (status)
+            return status;
+    }
+    status = CrGeniQuiesce(&p->i2c);
+    if (status)
+        return status;
+    if (p->tcs_claimed) {
+        status = CrRpmhPollRestore(p);
+        if (status)
+            return status;
+    }
+    if (p->pins_claimed) {
+        wr(p, p->board->bus_pins[0], p->saved_pins[0]);
+        wr(p, p->board->bus_pins[1], p->saved_pins[1]);
+        wr(p, p->board->irq_pin, p->saved_pins[2]);
+        p->pins_claimed = false;
+    }
+    status = CrClockPollRestore(p);
+    if (status) return status;
+    /* Keep shared power rails enabled and reset released. Disabling a vote
+     * with no readable previous vote would lose inherited bootloader state. */
+    p->initialized = false;
+    return 0;
+}
diff --git a/Library/GeniSeLib/geni_uefi.c b/Library/GeniSeLib/geni_uefi.c
new file mode 100644
index 0000000..a07092b
--- /dev/null
+++ b/Library/GeniSeLib/geni_uefi.c
@@ -0,0 +1,20 @@
+/* SPDX-License-Identifier: MIT */
+#include <Library/cr_geni.h>
+#include <Library/IoLib.h>
+#include <Library/TimerLib.h>
+#include <Library/BaseLib.h>
+static uint32_t read32(void *ctx, uintptr_t address)
+{ (void)ctx; MemoryFence(); uint32_t value = MmioRead32(address); MemoryFence(); return value; }
+static void write32(void *ctx, uintptr_t address, uint32_t value)
+{ (void)ctx; MemoryFence(); MmioWrite32(address, value); MemoryFence(); }
+static uint64_t now(void *ctx)
+{ (void)ctx; return GetTimeInNanoSecond(GetPerformanceCounter()) / 1000; }
+static void delay(void *ctx, uint32_t us)
+{ (void)ctx; MicroSecondDelay(us); }
+const struct CrIo *CrIoDefault(void)
+{
+  static const struct CrIo io = {0, read32, write32, now, delay};
+  return &io;
+}
+bool CrIoValid(const struct CrIo *io)
+{ return io && io->read32 && io->write32 && io->now_us && io->delay_us; }
diff --git a/Library/GeniSeLib/resource_io.h b/Library/GeniSeLib/resource_io.h
new file mode 100644
index 0000000..a23a6a7
--- /dev/null
+++ b/Library/GeniSeLib/resource_io.h
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: MIT */
+#pragma once
+#define CR_RESOURCE_BIT(n) (UINT32_C(1) << (n))
+#define RCG_CFG_MASK (0x1fU | (7U << 8) | (3U << 12))
+#define GPIO_CONFIG_MASK 0x3ffU
+#define CMD_DB_MAGIC UINT32_C(0x0c0330db)
+#define CMD_DB_HEADER_SIZE 144U
+#define CMD_DB_MAX_SIZE 0x20000U
+#define TCS_STRIDE 0x2a0U
+#define TCS_TRIGGER CR_RESOURCE_BIT(24)
+#define TCS_ENABLE CR_RESOURCE_BIT(16)
+#define TIMEOUT_US 1000U
+static inline uint32_t read_io(const struct CrIo *io, uintptr_t address)
+{
+    return io->read32(io->context, address);
+}
+static inline uint32_t rd(struct CrQupContext *p, uintptr_t address)
+{
+    return read_io(&p->io, address);
+}
+static inline void wr(struct CrQupContext *p, uintptr_t address, uint32_t value)
+{
+    p->io.write32(p->io.context, address, value);
+}
+static inline void rmw(struct CrQupContext *p, uintptr_t address,
+                uint32_t mask, uint32_t value)
+{
+    wr(p, address, (rd(p, address) & ~mask) | (value & mask));
+}
+static inline int wait_bits(struct CrQupContext *p, uintptr_t address,
+                     uint32_t mask, uint32_t value)
+{
+    uint64_t start = p->io.now_us(p->io.context);
+    for (unsigned i = 0; i <= TIMEOUT_US; ++i) {
+        if ((rd(p, address) & mask) == value)
+            return 0;
+        if (p->io.now_us(p->io.context) - start >= TIMEOUT_US)
+            break;
+        p->io.delay_us(p->io.context, 1);
+    }
+    return CR_BUS_TIMEOUT;
+}
