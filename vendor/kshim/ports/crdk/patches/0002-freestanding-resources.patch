diff --git a/Library/DebugUartLib/debug_uart_poll.c b/Library/DebugUartLib/debug_uart_poll.c
new file mode 100644
index 0000000..0a1eb77
--- /dev/null
+++ b/Library/DebugUartLib/debug_uart_poll.c
@@ -0,0 +1,157 @@
+/* SPDX-License-Identifier: MIT */
+#include <Library/cr_debug_uart_poll.h>
+#define CMD_ACTIVE (1U << 0)
+#define RX_ACTIVE (1U << 12)
+#define DONE (1U << 0)
+#define ABORT (1U << 5)
+#define ERRORS ((7U << 1) | (3U << 24) | (3U << 28))
+#define RX_ERRORS ((7U << 1) | (0x3fU << 9) | (3U << 24))
+/* IRQ enables are first so reverse restoration enables them last. */
+static const unsigned saved_offsets[] = {
+    0xe1c, 0x614, 0x644, 0x24, 0x28, 0x254, 0x260, 0x264,
+    0x284, 0x288, 0x25c, 0x2a4, 0x280, 0x2a8, 0x268,
+    0x28c, 0x26c, 0x80c, 0x810, 0x814, 0x270
+};
+static uint32_t rd(struct CrDebugUartPoll *u, unsigned off)
+{ return u->io.read32(u->io.context, u->base + off); }
+static void wr(struct CrDebugUartPoll *u, unsigned off, uint32_t v)
+{ u->io.write32(u->io.context, u->base + off, v); }
+static bool expired(struct CrDebugUartPoll *u, uint64_t start, uint32_t polls)
+{ return polls >= u->timeout_us || u->io.now_us(u->io.context) - start >= u->timeout_us; }
+static int stop(struct CrDebugUartPoll *u, bool rx)
+{
+    unsigned ctrl = rx ? 0x634 : 0x604, irq = rx ? 0x640 : 0x610;
+    uint32_t active = rx ? RX_ACTIVE : CMD_ACTIVE;
+    wr(u, irq + 8, ABORT);
+    wr(u, ctrl, 2);
+    uint64_t start = u->io.now_us(u->io.context);
+    for (uint32_t polls = 0; !expired(u, start, polls); ++polls) {
+        if ((rd(u, irq) & ABORT) && !(rd(u, 0x40) & active)) {
+            wr(u, irq + 8, ABORT);
+            return 0;
+        }
+        u->io.delay_us(u->io.context, 1);
+    }
+    u->poisoned = true;
+    return CR_BUS_TIMEOUT;
+}
+int CrDebugUartPollInit(struct CrDebugUartPoll *u)
+{
+    if (!u || !CrIoValid(&u->io) || !u->base || (u->base & 3) ||
+        u->size < 0xe2c || u->base > UINTPTR_MAX - u->size)
+        return CR_BUS_INVALID;
+    if (u->initialized || u->poisoned || u->claimed) return CR_BUS_BUSY;
+    if (!u->timeout_us) u->timeout_us = 20000;
+    if (((rd(u, 0x68) >> 8) & 0xff) != 2 || (rd(u, 0x64) & 1) || rd(u, 0x258))
+        return CR_BUS_UNSUPPORTED;
+    u->tx_depth = (rd(u, 0xe24) >> 16) & 0x3f;
+    u->rx_depth = (rd(u, 0xe28) >> 16) & 0x3f;
+    if (u->tx_depth < 2 || u->rx_depth < 2) return CR_BUS_UNSUPPORTED;
+    if (rd(u, 0x40) & CMD_ACTIVE) return CR_BUS_BUSY;
+    for (unsigned i = 0; i < sizeof(saved_offsets) / sizeof(saved_offsets[0]); ++i)
+        u->saved[i] = rd(u, saved_offsets[i]);
+    u->saved_rx_command = rd(u, 0x630);
+    u->inherited_rx = (rd(u, 0x40) & RX_ACTIVE) != 0;
+    u->claimed = true;
+    if ((rd(u, 0x40) & RX_ACTIVE) && stop(u, true)) return CR_BUS_TIMEOUT;
+    wr(u, 0xe1c, 0); wr(u, 0x614, 0); wr(u, 0x644, 0);
+    wr(u, 0x618, UINT32_MAX); wr(u, 0x648, UINT32_MAX);
+    wr(u, 0x28, rd(u, 0x28) | 0x7f); wr(u, 0x24, rd(u, 0x24) | 0x7f);
+    wr(u, 0x254, 0);
+    /* Four sequential byte lanes in one FIFO word, LSB first. */
+    uint32_t v[4];
+    for (unsigned i = 0; i < 4; ++i) v[i] = ((i * 8 + 7) << 5) | (1U << 4) | (7U << 1);
+    v[3] |= 1;
+    wr(u, 0x260, v[0] | (v[1] << 10)); wr(u, 0x264, v[2] | (v[3] << 10));
+    wr(u, 0x284, v[0] | (v[1] << 10)); wr(u, 0x288, v[2] | (v[3] << 10));
+    wr(u, 0x25c, 2); wr(u, 0x2a4, 0); wr(u, 0x280, 0); wr(u, 0x2a8, 0);
+    wr(u, 0x268, 8); wr(u, 0x28c, 8); wr(u, 0x26c, 0);
+    wr(u, 0x80c, 1); wr(u, 0x810, 1); wr(u, 0x814, u->rx_depth - 1);
+    wr(u, 0x630, 1U << 27);
+    u->rx_bytes = 0;
+    u->initialized = true;
+    return 0;
+}
+int CrDebugUartPollWrite(struct CrDebugUartPoll *u, const void *data, size_t length)
+{
+    if (!u || !u->initialized || (!data && length) || length > 0xffffff)
+        return CR_BUS_INVALID;
+    if (u->poisoned || (rd(u, 0x40) & CMD_ACTIVE)) return CR_BUS_BUSY;
+    if (!length) return 0;
+    const uint8_t *bytes = data;
+    size_t sent = 0;
+    int status = CR_BUS_TIMEOUT;
+    uint64_t start = u->io.now_us(u->io.context);
+    wr(u, 0x618, UINT32_MAX); wr(u, 0x270, length); wr(u, 0x600, 1U << 27);
+    for (uint32_t polls = 0; !expired(u, start, polls); ++polls) {
+        uint32_t irq = rd(u, 0x610), used = rd(u, 0x800) & 0xfffffff;
+        if ((irq & ERRORS) || used > u->tx_depth) { status = CR_BUS_IO; break; }
+        if (irq & DONE) {
+            if (sent != length || (rd(u, 0x40) & CMD_ACTIVE)) { status = CR_BUS_IO; break; }
+            wr(u, 0x618, DONE);
+            return 0;
+        }
+        while (used++ < u->tx_depth && sent < length) {
+            uint32_t word = 0;
+            for (unsigned i = 0; i < 4 && sent < length; ++i)
+                word |= (uint32_t)bytes[sent++] << (8 * i);
+            wr(u, 0x700, word);
+        }
+        u->io.delay_us(u->io.context, 1);
+    }
+    (void)stop(u, false);
+    return status;
+}
+static int drain_rx(struct CrDebugUartPoll *u)
+{
+    u->rx_bytes = 0;
+    uint32_t words = rd(u, 0x804) & 0x1ffffff;
+    if (words <= u->rx_depth) {
+        while (words--) (void)rd(u, 0x780);
+        if (!(rd(u, 0x804) & 0x1ffffff)) return 0;
+    }
+    u->poisoned = true;
+    return CR_BUS_IO;
+}
+static int recover_rx(struct CrDebugUartPoll *u)
+{
+    if ((rd(u, 0x40) & RX_ACTIVE) && stop(u, true)) return CR_BUS_TIMEOUT;
+    if (drain_rx(u)) return CR_BUS_IO;
+    wr(u, 0x648, UINT32_MAX);
+    wr(u, 0x630, 1U << 27);
+    return CR_BUS_IO; /* Discard the damaged sample; the next read can retry. */
+}
+int CrDebugUartPollRead(struct CrDebugUartPoll *u, uint8_t *byte)
+{
+    if (!u || !u->initialized || !byte || u->poisoned) return CR_BUS_INVALID;
+    if ((rd(u, 0x640) & RX_ERRORS) || !(rd(u, 0x40) & RX_ACTIVE))
+        return recover_rx(u);
+    if (!u->rx_bytes) {
+        uint32_t status = rd(u, 0x804), words = status & 0x1ffffff;
+        if (!words) return 0;
+        if (words > u->rx_depth) return recover_rx(u);
+        unsigned valid = (status >> 28) & 7;
+        if ((status & (1U << 31)) && words == 1 && valid > 4) return recover_rx(u);
+        u->rx_bytes = ((status & (1U << 31)) && words == 1 && valid) ? valid : 4;
+        u->rx_word = rd(u, 0x780);
+        if (words == 1) wr(u, 0x648, (1U << 26) | (1U << 27));
+    }
+    *byte = u->rx_word & 0xff;
+    u->rx_word >>= 8;
+    --u->rx_bytes;
+    return 1;
+}
+int CrDebugUartPollQuiesce(struct CrDebugUartPoll *u)
+{
+    if (!u) return CR_BUS_INVALID;
+    if (!u->claimed) return 0;
+    if ((rd(u, 0x40) & CMD_ACTIVE) && stop(u, false)) return CR_BUS_TIMEOUT;
+    if ((rd(u, 0x40) & RX_ACTIVE) && stop(u, true)) return CR_BUS_TIMEOUT;
+    if (drain_rx(u)) return CR_BUS_IO;
+    wr(u, 0x618, UINT32_MAX); wr(u, 0x648, UINT32_MAX);
+    for (unsigned i = sizeof(saved_offsets) / sizeof(saved_offsets[0]); i > 0; --i)
+        wr(u, saved_offsets[i - 1], u->saved[i - 1]);
+    if (u->inherited_rx) wr(u, 0x630, u->saved_rx_command);
+    u->initialized = u->poisoned = u->claimed = false;
+    return 0;
+}
