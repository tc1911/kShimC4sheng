+#define GENI_SE_DMA_TX_CLK_CGC_ON KGENI_BIT(1)
+#define GENI_SE_DMA_AHB_SLV_CFG_ON KGENI_BIT(2)
+#define GENI_SE_AHB_SEC_SLV_CLK_CGC_ON KGENI_BIT(3)
