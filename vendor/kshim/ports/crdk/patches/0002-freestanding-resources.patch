+/* Copyright (c) 2025-2026 Project Aloha Authors and Kancy Joe.
+ * SPDX-License-Identifier: MIT */
+#include <Library/cr_resources.h>
+#include "../GeniSeLib/resource_io.h"
+static bool valid(const struct CrQupContext *p)
+{
+    if (!p || !p->board || !CrIoValid(&p->io)) return false;
+    const struct CrQupResources *r = p->board;
+    const uintptr_t regs[] = {r->vote, r->rcg, r->ahb_halt[0], r->ahb_halt[1], r->serial_halt};
+    for (unsigned i = 0; i < sizeof(regs) / sizeof(regs[0]); ++i)
+        if (!regs[i] || (regs[i] & 3) || regs[i] > UINTPTR_MAX - 4) return false;
+    return r->rcg <= UINTPTR_MAX - 0x3c && r->geni && !(r->geni & 3) &&
+        r->geni_size >= 0x44 && r->geni <= UINTPTR_MAX - r->geni_size &&
+        r->serial_vote && r->ahb_votes && !(r->serial_vote & r->ahb_votes);
+}
+int CrClockPollPrepare(struct CrQupContext *p, uint8_t *index)
+{
+    if (!valid(p) || !index) return CR_BUS_INVALID;
+    if (p->clocks_claimed || p->rcg_changed) return CR_BUS_BUSY;
+    const struct CrQupResources *board = p->board;
+    uint32_t wanted = board->ahb_votes | board->serial_vote;
+    uint32_t old_vote = rd(p, board->vote);
+    p->added_clock_votes = wanted & ~old_vote;
+    p->clocks_claimed = true;
+    wr(p, board->vote, old_vote | board->ahb_votes);
+    int status = wait_bits(p, board->ahb_halt[0], CR_RESOURCE_BIT(31), 0);
+    if (!status)
+        status = wait_bits(p, board->ahb_halt[1], CR_RESOURCE_BIT(31), 0);
+    if (status)
+        return status;
+    /* The AHB window is now accessible. Never retune an inherited active SE. */
+    if (rd(p, board->geni + 0x40U) & (CR_RESOURCE_BIT(0) | CR_RESOURCE_BIT(12)))
+        return CR_BUS_BUSY;
+    if (rd(p, board->rcg + 0x14U) & 1U) {
+        /* DFS tables are owned by boot firmware. Select a verified 19.2 MHz
+         * undivided CXO entry without rewriting the table or enabling PLLs. */
+        bool found = false;
+        for (unsigned i = 0; i < 8; ++i) {
+            uint32_t cfg = rd(p, board->rcg + 0x1cU + i * 4U);
+            if ((cfg & ((7U << 8) | (3U << 12))) == 0 && (cfg & 0x1fU) <= 1U) {
+                *index = (uint8_t)i;
+                found = true;
+                break;
+            }
+        }
+        if (!found)
+            return CR_BUS_UNSUPPORTED;
+    } else {
+        p->saved_rcg_config = rd(p, board->rcg + 4U);
+        uint32_t next = (p->saved_rcg_config & ~RCG_CFG_MASK) | 1U;
+        if (next != p->saved_rcg_config) {
+            p->rcg_changed = true;
+            wr(p, board->rcg + 4U, next);
+            rmw(p, board->rcg, 1U, 1U);
+            status = wait_bits(p, board->rcg, 1U, 0);
+            if (status)
+                return status;
+        }
+        *index = 0;
+    }
+    rmw(p, board->vote, board->serial_vote, board->serial_vote);
+    return wait_bits(p, board->serial_halt, CR_RESOURCE_BIT(31), 0);
+}
+
+
+int CrClockPollRestore(struct CrQupContext *p)
+{
+    if (!valid(p)) return CR_BUS_INVALID;
+    int status;
+    if (p->rcg_changed) {
+        wr(p, p->board->rcg + 4U, p->saved_rcg_config);
+        rmw(p, p->board->rcg, 1U, 1U);
+        status = wait_bits(p, p->board->rcg, 1U, 0);
+        if (status)
+            return status;
+        p->rcg_changed = false;
+    }
+    if (p->clocks_claimed) {
+        rmw(p, p->board->vote, p->added_clock_votes, 0);
+        p->clocks_claimed = false;
+    }
+    return 0;
+}
