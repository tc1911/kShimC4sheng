+    GENI_SE_DMA_MODE_EN, GENI_SE_TX_PACKING_CFG0, GENI_SE_TX_PACKING_CFG1,
+    GENI_SE_RX_PACKING_CFG0, GENI_SE_RX_PACKING_CFG1,
+    GENI_SE_TX_WATERMARK_REG, GENI_SE_RX_WATERMARK_REG,
+    GENI_SE_RX_RFR_WATERMARK_REG, GENI_SE_GSI_EVENT_EN,
