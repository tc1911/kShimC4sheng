+  *Owned = FALSE;
+  if (Name == NULL || VoltageMv == 0 || VoltageMv > 0xFFFFU ||
+      ((Mode != 2) && (Mode != 3) && (Mode != 4) && (Mode != 6) && (Mode != 7))) {
+    return EFI_INVALID_PARAMETER;
+  }
+  EfiAcquireLock (&mRailLock);
+  Rail = FindRail (Name);
+  if (Rail == NULL) { Status = EFI_NOT_FOUND; goto Exit; }
+  if (Rail->ReferenceCount == MAX_UINTN) {
+    Status = EFI_OUT_OF_RESOURCES; goto Exit;
+  }
+  if (Rail->ReferenceCount != 0) {
+    if (Rail->VoltageMv != VoltageMv || Rail->Mode != Mode ||
+        !Rail->EnableRequested) {
+      Status = EFI_ACCESS_DENIED; goto Exit;
+    }
+    Rail->ReferenceCount++;
+    *Owned = TRUE;
+    Status = EFI_SUCCESS;
+    goto Exit;
+  }
+  /* A previous failed transaction must finish its release before reuse. */
+  if (Rail->VoltageRequested || Rail->ModeRequested || Rail->EnableRequested) {
+    Status = EFI_NOT_READY; goto Exit;
+  }
+  Rail->ReferenceCount = 1;
+  Rail->VoltageMv = 0;
+  Rail->Mode = 0;
+  *Owned = TRUE;
+  Status = IssueVote (Rail->VoltageClient, VoltageMv, &Rail->VoltageRequested);
+  if (EFI_ERROR (Status)) { goto Exit; }
+  Rail->VoltageMv = VoltageMv;
+  Status = IssueVote (Rail->ModeClient, Mode, &Rail->ModeRequested);
+  if (EFI_ERROR (Status)) { goto Exit; }
+  Rail->Mode = Mode;
+  Status = IssueVote (Rail->EnableClient, 1, &Rail->EnableRequested);
+  if (EFI_ERROR (Status)) {
+    /* Do not allow a second consumer to adopt an uncertain enable. */
+    Rail->Mode = 0;
+  }
+Exit:
   EfiReleaseLock (&mRailLock);
   return Status;
 }
