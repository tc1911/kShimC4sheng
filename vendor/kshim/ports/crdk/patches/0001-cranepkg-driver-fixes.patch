diff --git a/Tests/GeniPinmuxTest.h b/Tests/GeniPinmuxTest.h
new file mode 100644
index 0000000..3114710
--- /dev/null
+++ b/Tests/GeniPinmuxTest.h
@@ -0,0 +1,38 @@
+/** @file Pinmux failures must prevent starting an I2C transaction. SPDX-License-Identifier: MIT */
+static EFI_STATUS PinLocateStatus;
+static UINTN PinCalls;
+static UINTN PinFailAt;
+static EFI_STATUS EFIAPI TestConfigPin (EFI_GPIO_CR_PROTOCOL *This,
+                                      GpioConfigParams *Config) {
+  (VOID)This;
+  assert (Config->PinNumber == 32 + PinCalls);
+  /* pinctrl-sm8450.c: PINGROUP(32/33, qup9, ibi_i3c, ...), f1. */
+  assert (Config->FunctionSel == GPIO_FUNC_1);
+  ++PinCalls;
+  return PinCalls == PinFailAt ? EFI_DEVICE_ERROR : EFI_SUCCESS;
+}
+static EFI_GPIO_CR_PROTOCOL PinProtocol;
+static EFI_STATUS EFIAPI LocatePins (EFI_GUID *Guid, VOID *Registration, VOID **Interface) {
+  (VOID)Registration;
+  assert (Guid == &gEfiGpioCrProtocolGuid);
+  *Interface = EFI_ERROR (PinLocateStatus) ? NULL : &PinProtocol;
+  return PinLocateStatus;
+}
+static void TestPinmux (void) {
+  EFI_LOCATE_PROTOCOL Saved = BootServices.LocateProtocol;
+  BootServices.LocateProtocol = LocatePins;
+  PinLocateStatus = EFI_NOT_FOUND;
+  assert (TEST_CONFIGURE_PINS () == EFI_NOT_FOUND);
+  PinLocateStatus = EFI_SUCCESS;
+  assert (TEST_CONFIGURE_PINS () == EFI_NOT_READY);
+  PinProtocol.ConfigGpio = TestConfigPin;
+  for (PinFailAt = 1; PinFailAt <= 2; ++PinFailAt) {
+    PinCalls = 0;
+    assert (TEST_CONFIGURE_PINS () == EFI_DEVICE_ERROR);
+    assert (PinCalls == PinFailAt);
+  }
+  PinFailAt = PinCalls = 0;
+  assert (TEST_CONFIGURE_PINS () == EFI_SUCCESS);
+  assert (PinCalls == 2);
+  BootServices.LocateProtocol = Saved;
+}
diff --git a/Tests/GeniTestCommon.h b/Tests/GeniTestCommon.h
new file mode 100644
index 0000000..88bde72
--- /dev/null
+++ b/Tests/GeniTestCommon.h
@@ -0,0 +1,61 @@
+/** @file Linux-derived GENI transport behavior test support. SPDX-License-Identifier: MIT */
+#include <assert.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#undef NULL
+#include <Uefi.h>
+#include <Library/BaseMemoryLib.h>
+#include <Library/CacheMaintenanceLib.h>
+#include <Library/DebugLib.h>
+#include <Library/MemoryAllocationLib.h>
+#include <Library/SynchronizationLib.h>
+#include <Library/CrDalLib.h>
+
+static EFI_BOOT_SERVICES BootServices;
+EFI_BOOT_SERVICES *gBS = &BootServices;
+EFI_GUID gEfiQupCrProtocolGuid;
+EFI_GUID gEfiClockCrProtocolGuid;
+EFI_GUID gEfiInterconnectCrProtocolGuid;
+EFI_GUID gEfiGpioCrProtocolGuid;
+static CR_TARGET_QUP_WRAPPER TestWrapper = {
+  .Id = 1, .SerialEngineCount = 2, .SerialEngineBase = {0, 0xa84000}
+};
+static CR_TARGET_QUP_CONTEXT TestContext = {.Qup = &TestWrapper, .QupCount = 1};
+CONST CR_TARGET_QUP_CONTEXT *CrDalGetQupContext (VOID) { return &TestContext; }
+VOID *EFIAPI AllocateZeroPool (UINTN Size) { return calloc (1, Size); }
+VOID EFIAPI FreePool (VOID *Buffer) { free (Buffer); }
+VOID *EFIAPI CopyMem (VOID *D, CONST VOID *S, UINTN N) { return memcpy (D, S, N); }
+VOID *EFIAPI ZeroMem (VOID *D, UINTN N) { return memset (D, 0, N); }
+UINT32 EFIAPI InterlockedCompareExchange32 (volatile UINT32 *P, UINT32 C, UINT32 E) {
+  UINT32 Old = *P;
+  if (Old == C) *P = E;
+  return Old;
+}
+BOOLEAN EFIAPI DebugPrintEnabled (VOID) { return FALSE; }
+BOOLEAN EFIAPI DebugPrintLevelEnabled (CONST UINTN Level) { (VOID)Level; return FALSE; }
+VOID EFIAPI DebugPrint (UINTN Level, CONST CHAR8 *Format, ...) { (VOID)Level; (VOID)Format; }
+static void (*TestWriteBackHook)(VOID *Start, UINTN Length);
+VOID *EFIAPI WriteBackDataCacheRange (VOID *Start, UINTN Length) {
+  if (TestWriteBackHook != NULL) TestWriteBackHook (Start, Length);
+  return Start;
+}
+VOID *EFIAPI InvalidateDataCacheRange (VOID *Start, UINTN Length) { (VOID)Length; return Start; }
+
+#include "../Driver/QUPCrDxe/QUPCrDxe.c"
+
+static void TestOwnership (void) {
+  UINT8 FifoOwner, GpiOwner;
+  mQupContext = &TestContext;
+  assert (QupAcquireSe (&mQupProtocol, 1, 1, &FifoOwner, QupCrSeFifo) == EFI_SUCCESS);
+  assert (QupAcquireSe (&mQupProtocol, 1, 1, &GpiOwner, QupCrSeGpi) == EFI_ALREADY_STARTED);
+  assert (QupReleaseSe (&mQupProtocol, 1, 1, &GpiOwner, TRUE) == EFI_ACCESS_DENIED);
+  assert (QupReleaseSe (&mQupProtocol, 1, 1, &FifoOwner, TRUE) == EFI_SUCCESS);
+  assert (QupAcquireSe (&mQupProtocol, 1, 1, &GpiOwner, QupCrSeGpi) == EFI_SUCCESS);
+  assert (QupAcquireSe (&mQupProtocol, 1, 1, &FifoOwner, QupCrSeFifo) == EFI_ALREADY_STARTED);
+  assert (QupReleaseSe (&mQupProtocol, 1, 1, &GpiOwner, FALSE) == EFI_DEVICE_ERROR);
+  assert (QupReleaseSe (&mQupProtocol, 1, 1, &GpiOwner, TRUE) == EFI_DEVICE_ERROR);
+  assert (QupAcquireSe (&mQupProtocol, 1, 1, &FifoOwner, QupCrSeFifo) == EFI_DEVICE_ERROR);
+  ZeroMem (mSeOwners, sizeof (mSeOwners));
+}
diff --git a/Tests/GpiDmaLifetimeTest.h b/Tests/GpiDmaLifetimeTest.h
new file mode 100644
index 0000000..e618f90
--- /dev/null
+++ b/Tests/GpiDmaLifetimeTest.h
@@ -0,0 +1,98 @@
+/** @file IOMMU failure injection for actual GPI allocation code. SPDX-License-Identifier: MIT */
+static UINT8 DmaAllocation[EFI_PAGE_SIZE];
+static UINT32 DmaMapCalls, DmaUnmapCalls, DmaFreeCalls, DmaAttributeCalls;
+static BOOLEAN DmaPartial, DmaFailAttribute, DmaFailUnmap, DmaFailFree;
+static EFI_STATUS EFIAPI DmaAllocate (EDKII_IOMMU_PROTOCOL *This,
+    EFI_ALLOCATE_TYPE Type, EFI_MEMORY_TYPE MemoryType, UINTN Pages,
+    VOID **Host, UINT64 Attributes) {
+  (VOID)This; (VOID)Type; (VOID)MemoryType; (VOID)Attributes;
+  assert (Pages == 1); *Host = DmaAllocation; return EFI_SUCCESS;
+}
+static EFI_STATUS EFIAPI DmaMap (EDKII_IOMMU_PROTOCOL *This,
+    EDKII_IOMMU_OPERATION Operation, VOID *Host, UINTN *Bytes,
+    EFI_PHYSICAL_ADDRESS *Device, VOID **Mapping) {
+  (VOID)This;
+  assert (Operation == EdkiiIoMmuOperationBusMasterCommonBuffer64);
+  assert (Host == DmaAllocation && *Bytes == EFI_PAGE_SIZE);
+  ++DmaMapCalls;
+  if (DmaPartial) --*Bytes;
+  *Device = 0x400000; *Mapping = DmaAllocation; return EFI_SUCCESS;
+}
+static EFI_STATUS EFIAPI DmaAttribute (EDKII_IOMMU_PROTOCOL *This,
+    UINT64 Base, UINT32 Sid, VOID *Mapping, UINT64 Access) {
+  (VOID)This;
+  assert (Base == 0x15000000 && Sid == GPI_SID && Mapping == DmaAllocation);
+  assert (Access == (EDKII_IOMMU_ACCESS_READ | EDKII_IOMMU_ACCESS_WRITE));
+  ++DmaAttributeCalls;
+  return DmaFailAttribute ? EFI_DEVICE_ERROR : EFI_SUCCESS;
+}
+static EFI_STATUS EFIAPI DmaUnmap (EDKII_IOMMU_PROTOCOL *This, VOID *Mapping) {
+  (VOID)This; assert (Mapping == DmaAllocation); ++DmaUnmapCalls;
+  return DmaFailUnmap ? EFI_DEVICE_ERROR : EFI_SUCCESS;
+}
+static EFI_STATUS EFIAPI DmaFree (EDKII_IOMMU_PROTOCOL *This, UINTN Pages, VOID *Host) {
+  (VOID)This; assert (Pages == 1 && Host == DmaAllocation); ++DmaFreeCalls;
+  return DmaFailFree ? EFI_DEVICE_ERROR : EFI_SUCCESS;
+}
+static EDKII_IOMMU_PROTOCOL DmaIommu = {
+  .AllocateBuffer = DmaAllocate, .Map = DmaMap, .SetAttributeById = DmaAttribute,
+  .Unmap = DmaUnmap, .FreeBuffer = DmaFree
+};
+static UINT8 DeviceRingMemory[EFI_PAGE_SIZE];
+static void PublishRingMemory (VOID *Start, UINTN Length) {
+  assert (Start == DmaAllocation && Length == sizeof (DeviceRingMemory));
+  memcpy (DeviceRingMemory, Start, Length);
+}
+static void TestRingCacheVisibility (void) {
+  GPI_RING Ring = {0};
+  ZeroMem (&mGpi, sizeof (mGpi));
+  mGpi.Iommu = &DmaIommu;
+  DmaPartial = DmaFailAttribute = DmaFailUnmap = DmaFailFree = FALSE;
+  /* Model non-coherent memory: CPU stores do not reach the device until
+     cache writeback. Both reused memory and its CPU copy begin nonzero. */
+  memset (DmaAllocation, 0xa5, sizeof (DmaAllocation));
+  memset (DeviceRingMemory, 0xa5, sizeof (DeviceRingMemory));
+  TestWriteBackHook = PublishRingMemory;
+  assert (GpiRingAllocate (GPI_EVENT_ELEMENTS, &Ring) == EFI_SUCCESS);
+  TestWriteBackHook = NULL;
+  for (UINTN Index = 0; Index < sizeof (DeviceRingMemory); ++Index)
+    assert (DeviceRingMemory[Index] == 0);
+  GpiRingFree (&Ring);
+  assert (Ring.Host == NULL);
+  puts ("GPI DMA: initialized event ring visible to non-coherent device before publication passed");
+}
+static void TestDmaLifetime (void) {
+  TestRingCacheVisibility ();
+  for (UINT32 Fault = 0; Fault < 6; ++Fault) {
+    GPI_RING Ring = {0};
+    ZeroMem (&mGpi, sizeof (mGpi));
+    mGpi.Iommu = &DmaIommu;
+    DmaMapCalls = DmaUnmapCalls = DmaFreeCalls = DmaAttributeCalls = 0;
+    DmaPartial = Fault < 2;
+    DmaFailAttribute = Fault == 2 || Fault == 3;
+    DmaFailUnmap = Fault == 1 || Fault == 3 || Fault == 4;
+    DmaFailFree = Fault == 5;
+    EFI_STATUS Status = GpiRingAllocate (16, &Ring);
+    if (Fault < 4) {
+      assert (Status == (DmaPartial ? EFI_BAD_BUFFER_SIZE : EFI_DEVICE_ERROR));
+      assert (DmaAttributeCalls == (DmaPartial ? 0U : 1U));
+    } else {
+      assert (Status == EFI_SUCCESS);
+      GpiRingFree (&Ring);
+    }
+    assert (DmaUnmapCalls == 1);
+    if (DmaFailUnmap || DmaFailFree) {
+      assert (mGpi.DmaCleanupFailed && Ring.Host == DmaAllocation && Ring.Pages == 1);
+      assert (Ring.Mapping == (DmaFailUnmap ? DmaAllocation : NULL));
+      assert (DmaFreeCalls == (DmaFailUnmap ? 0U : 1U));
+      assert (GpiInitialize (GPI_I2C_INSTANCE) == EFI_DEVICE_ERROR);
+      assert (DmaMapCalls == 1);
+      DmaFailUnmap = DmaFailFree = FALSE;
+      GpiRingFree (&Ring);
+      assert (Ring.Host == NULL);
+    } else {
+      assert (Ring.Host == NULL && DmaFreeCalls == 1);
+    }
+  }
+  puts ("GPI DMA: short mapping rejection, failed unmap/free retention and retry fencing passed");
+}
diff --git a/Tests/GpiTransportTest.c b/Tests/GpiTransportTest.c
new file mode 100644
index 0000000..04fcde3
--- /dev/null
+++ b/Tests/GpiTransportTest.c
@@ -0,0 +1,283 @@
+/** @file Qualcomm GPI ring, completion and quiescence tests. SPDX-License-Identifier: MIT */
+#include "GeniTestCommon.h"
+#include "../Driver/GpiCrDxe/GpiCrDxe.c"
+
+#define TEST_CONFIGURE_PINS GpiConfigurePins
+#include "GeniPinmuxTest.h"
+#include "GpiDmaLifetimeTest.h"
+
+EFI_GUID gEfiGpiCrProtocolGuid;
+EFI_GUID gEfiSmmuCrProtocolGuid;
+EFI_GUID gEdkiiIoMmuProtocolGuid;
+
+static UINT32 Registers[0x30000 / 4];
+static UINT32 SeRegisters[0x1000 / 4];
+static UINT32 TxData[64], RxData[64], Events[256], DmaData[1024];
+static UINT32 TxHardwareOffset, RxHardwareOffset, EventProducer;
+static UINT32 Writes, Completions, Aborts, Releases;
+static BOOLEAN TransferTimeout, StopTimeout, AbortTimeout, WrongPointer, WrongLength;
+static BOOLEAN EventResetTimeout;
+static BOOLEAN CheckLease;
+static UINT32 NotifyStatus, CompletionStatus;
+
+UINT32 EFIAPI MmioRead32 (UINTN Address) {
+  if (Address >= mGpi.SeBase && Address < mGpi.SeBase + sizeof (SeRegisters))
+    return SeRegisters[(Address - mGpi.SeBase) / 4];
+  assert (Address >= mGpi.GpiBase && Address < mGpi.GpiBase + sizeof (Registers));
+  return Registers[(Address - mGpi.GpiBase) / 4];
+}
+
+static void CompleteDoorbell (UINT8 Channel, UINT32 Value) {
+  GPI_RING *Ring = Channel == GPI_TX_CH ? &mGpi.TxRing : &mGpi.RxRing;
+  UINT32 *HardwareOffset = Channel == GPI_TX_CH ? &TxHardwareOffset : &RxHardwareOffset;
+  UINT32 End = Value - (UINT32)Ring->Device;
+  assert (End < Ring->Length && End % GPI_EL_SIZE == 0);
+  while (*HardwareOffset != End) {
+    UINT32 *Tre = (UINT32 *)((UINT8 *)Ring->Host + *HardwareOffset);
+    UINT32 Type = (Tre[3] >> 16) & 0xff;
+    /* A skipped slot or stale element cannot be interpreted as a valid TRE. */
+    assert (Type == GPI_TRE_CONFIG0 || Type == GPI_TRE_GO || Type == GPI_TRE_DMA);
+    if (Type == GPI_TRE_DMA && !TransferTimeout) {
+      if (NotifyStatus != 0) {
+        UINT32 *Notify = (UINT32 *)((UINT8 *)mGpi.EventRing.Host + EventProducer);
+        Notify[0] = NotifyStatus;
+        Notify[1] = Notify[2] = 0;
+        Notify[3] = (GPI_EVENT_QUP_NOTIFY << 16) | ((UINT32)Channel << 24);
+        EventProducer = (EventProducer + GPI_EL_SIZE) % mGpi.EventRing.Length;
+      }
+      UINT32 *Event = (UINT32 *)((UINT8 *)mGpi.EventRing.Host + EventProducer);
+      EFI_PHYSICAL_ADDRESS Pointer = Ring->Device + *HardwareOffset + (WrongPointer ? 16 : 0);
+      Event[0] = (UINT32)Pointer;
+      Event[1] = (UINT32)(Pointer >> 32);
+      Event[2] = (GPI_EVENT_EOT << 24) | (Tre[2] - (WrongLength ? 1 : 0));
+      Event[3] = (GPI_EVENT_XFER_COMPLETE << 16) | ((UINT32)Channel << 24) | CompletionStatus;
+      EventProducer = (EventProducer + GPI_EL_SIZE) % mGpi.EventRing.Length;
+      Registers[(GPI_EV_CTX (GPII_ID) + GPI_RING_RP_L) / 4] =
+        (UINT32)(mGpi.EventRing.Device + EventProducer);
+      Registers[(GPI_EV_CTX (GPII_ID) + GPI_RING_RP_H) / 4] =
+        (UINT32)(mGpi.EventRing.Device >> 32);
+      ++Completions;
+    }
+    /* Model hardware consuming the TRE.  Reusing it without writing a new
+       element must fail, including at the ring wrap boundary. */
+    ZeroMem (Tre, GPI_EL_SIZE);
+    *HardwareOffset = (*HardwareOffset + GPI_EL_SIZE) % Ring->Length;
+  }
+}
+
+UINT32 EFIAPI MmioWrite32 (UINTN Address, UINT32 Value) {
+  ++Writes;
+  if (CheckLease) assert (mSeOwners[1][1].Busy != 0);
+  if (Address >= mGpi.SeBase && Address < mGpi.SeBase + sizeof (SeRegisters)) {
+    UINTN Offset = Address - mGpi.SeBase;
+    if (Offset == SE_M_IRQ_CLEAR) SeRegisters[SE_M_IRQ_STATUS / 4] &= ~Value;
+    else SeRegisters[Offset / 4] = Value;
+    if (Offset == SE_M_CMD_CTRL && Value == BIT (1)) {
+      ++Aborts;
+      if (!AbortTimeout) {
+        SeRegisters[SE_M_IRQ_STATUS / 4] |= SE_M_CMD_ABORT;
+        SeRegisters[SE_GENI_STATUS / 4] = 0;
+      }
+    }
+    return Value;
+  }
+  UINTN Offset = Address - mGpi.GpiBase;
+  assert (Offset < sizeof (Registers));
+  if (Offset == GPI_CH_CMD (GPII_ID) || Offset == GPI_EV_CMD (GPII_ID)) {
+    BOOLEAN Event = Offset == GPI_EV_CMD (GPII_ID);
+    UINT32 Channel = Value & 0xff;
+    UINT32 Opcode = Value >> 24;
+    UINTN Config = Event ? GPI_EV_CTX (GPII_ID) : GPI_CH_CTX (GPII_ID, Channel);
+    assert (Channel < 2);
+    if (Opcode == 2 && StopTimeout) return Value;
+    if (Event && Opcode == 9 && EventResetTimeout) return Value;
+    /* Linux: DEALLOC acknowledges but leaves the hardware state unchanged. */
+    UINT32 State = Opcode == 10 ? GPI_STATE (Registers[Config / 4]) :
+        Opcode == 0 || Opcode == 9 ? 1 : Opcode == 1 ? 2 : Opcode == 2 ? 3 : 0;
+    Registers[Config / 4] = (Registers[Config / 4] & ~(0xfU << 20)) | (State << 20);
+    Registers[(Event ? GPI_EV_CTRL_STATUS (GPII_ID) : GPI_CH_CTRL_STATUS (GPII_ID)) / 4] |=
+        Event ? BIT (0) : BIT (Channel);
+    if (Opcode == 0 || Opcode == 9) {
+      if (Event) {
+        EventProducer = 0;
+        Registers[(Config + GPI_RING_RP_L) / 4] = (UINT32)mGpi.EventRing.Device;
+      } else if (Channel == GPI_TX_CH) TxHardwareOffset = 0;
+      else RxHardwareOffset = 0;
+    }
+  } else if (Offset == GPI_EV_CTRL_CLEAR (GPII_ID)) {
+    Registers[GPI_EV_CTRL_STATUS (GPII_ID) / 4] &= ~Value;
+  } else if (Offset == GPI_CH_CTRL_CLEAR (GPII_ID)) {
+    Registers[GPI_CH_CTRL_STATUS (GPII_ID) / 4] &= ~Value;
+  } else if (Offset == GPI_CH_CTX (GPII_ID, 0) ||
+             Offset == GPI_CH_CTX (GPII_ID, 1) || Offset == GPI_EV_CTX (GPII_ID)) {
+    Registers[Offset / 4] = (Value & ~(0xfU << 20)) | (Registers[Offset / 4] & (0xfU << 20));
+  } else {
+    Registers[Offset / 4] = Value;
+    if (Offset == GPI_CH_DB (GPII_ID, GPI_TX_CH)) CompleteDoorbell (GPI_TX_CH, Value);
+    if (Offset == GPI_CH_DB (GPII_ID, GPI_RX_CH)) CompleteDoorbell (GPI_RX_CH, Value);
+  }
+  return Value;
+}
+UINTN EFIAPI MicroSecondDelay (UINTN Delay) { return Delay; }
+
+static EFI_STATUS EFIAPI Locate (EFI_GUID *Guid, VOID *Registration, VOID **Interface) {
+  (VOID)Registration;
+  assert (Guid == &gEfiQupCrProtocolGuid);
+  *Interface = &mQupProtocol;
+  return EFI_SUCCESS;
+}
+static EFI_STATUS EFIAPI Release (EFI_QUP_CR_PROTOCOL *This, UINT8 Wrapper,
+                                  UINT8 Engine, VOID *Owner, BOOLEAN Quiesced) {
+  ++Releases;
+  if (Quiesced) {
+    assert (!mGpi.ChannelTouched[0] && !mGpi.ChannelTouched[1] && !mGpi.EventTouched);
+    assert (SeRegisters[SE_GSI_EVENT_EN / 4] == 0);
+  }
+  return QupReleaseSe (This, Wrapper, Engine, Owner, Quiesced);
+}
+static void Reset (void) {
+  ZeroMem (&mGpi, sizeof (mGpi));
+  ZeroMem (mSeOwners, sizeof (mSeOwners));
+  ZeroMem (Registers, sizeof (Registers));
+  ZeroMem (SeRegisters, sizeof (SeRegisters));
+  SeRegisters[SE_GENI_FW_REVISION_RO / 4] = 3U << 8;
+  ZeroMem (TxData, sizeof (TxData));
+  ZeroMem (RxData, sizeof (RxData));
+  ZeroMem (Events, sizeof (Events));
+  mQupContext = &TestContext;
+  mQupProtocol.ReleaseSe = Release;
+  BootServices.LocateProtocol = Locate;
+  mGpi.Protocol = mGpiProtocol;
+  mGpi.Qup = &mQupProtocol;
+  mGpi.GpiBase = 0x9f0000;
+  mGpi.SeBase = 0xa84000;
+  mGpi.TxRing = (GPI_RING){.Host = TxData, .Device = 0x100000, .Length = sizeof (TxData), .ElSize = 16};
+  mGpi.RxRing = (GPI_RING){.Host = RxData, .Device = 0x200000, .Length = sizeof (RxData), .ElSize = 16};
+  mGpi.EventRing = (GPI_RING){.Host = Events, .Device = 0x300000, .Length = sizeof (Events), .ElSize = 16};
+  mGpi.Data = (GPI_BUFFER){.Host = DmaData, .Device = 0x400000, .Pages = 1};
+  mGpi.Initialized = TRUE;
+  TxHardwareOffset = RxHardwareOffset = EventProducer = Writes = Completions = Aborts = Releases = 0;
+  TransferTimeout = StopTimeout = AbortTimeout = WrongPointer = WrongLength = FALSE;
+  EventResetTimeout = FALSE;
+  CheckLease = TRUE;
+  NotifyStatus = CompletionStatus = 0;
+}
+static void TestProtocolErrors (void) {
+  UINT8 Buffer = 0;
+  const UINT32 NotifyBits[] = {BIT (10), BIT (12), BIT (13)};
+  const UINT32 CompletionBits[] = {BIT (6), BIT (8), BIT (9)};
+  for (UINT32 Read = 0; Read < 2; ++Read) {
+    EFI_GPI_I2C_DESCRIPTOR Desc = {&Buffer, 1,
+      EFI_GPI_I2C_FLAG_START | EFI_GPI_I2C_FLAG_STOP |
+      (Read ? EFI_GPI_I2C_FLAG_READ : EFI_GPI_I2C_FLAG_WRITE)};
+    for (UINT32 Index = 0; Index < 6; ++Index) {
+      UINT32 Transferred = 1;
+      Reset ();
+      if (Index < 3) NotifyStatus = NotifyBits[Index];
+      else CompletionStatus = CompletionBits[Index - 3];
+      assert (GpiI2cTransfer (&mGpi.Protocol, 10, 0x2b, &Desc, 1,
+          &Transferred) == EFI_DEVICE_ERROR);
+      assert (Transferred == 0 && Aborts == 1 && mSeOwners[1][1].Busy == 0);
+    }
+    /* A notification without the documented I2C error bits is harmless. */
+    Reset ();
+    NotifyStatus = BIT (0);
+    assert (GpiI2cTransfer (&mGpi.Protocol, 10, 0x2b, &Desc, 1, NULL) == EFI_SUCCESS);
+    Reset ();
+    NotifyStatus = BIT (10);
+    CompletionStatus = BIT (6);
+    SeRegisters[SE_M_GP_LENGTH / 4] = 1;
+    assert (GpiI2cTransfer (&mGpi.Protocol, 10, 0x2b, &Desc, 1, NULL) ==
+        (Read ? EFI_SUCCESS : EFI_DEVICE_ERROR));
+  }
+}
+static void TestTransfers (void) {
+  UINT8 Buffer[8] = {0};
+  EFI_GPI_I2C_DESCRIPTOR Descs[40];
+  UINT32 Transferred;
+  Reset ();
+  for (UINT32 Index = 0; Index < 40; ++Index)
+    Descs[Index] = (EFI_GPI_I2C_DESCRIPTOR){Buffer, sizeof (Buffer),
+        EFI_GPI_I2C_FLAG_START | EFI_GPI_I2C_FLAG_STOP |
+        (Index % 2 ? EFI_GPI_I2C_FLAG_READ : EFI_GPI_I2C_FLAG_WRITE)};
+  assert (GpiI2cTransfer (&mGpi.Protocol, 10, 0x2b, Descs, 40, &Transferred) == EFI_SUCCESS);
+  assert (Transferred == 320 && Completions == 40 && Releases == 1);
+  /* Recycled EREs remain device-owned: never dirty their shared cache line
+     by clearing the consumed element from the CPU. */
+  assert (Events[3] == (GPI_EVENT_XFER_COMPLETE << 16));
+  assert (mSeOwners[1][1].Busy == 0);
+  /* Cross-request reinitialization starts at element zero again. */
+  assert (GpiI2cTransfer (&mGpi.Protocol, 10, 0x2b, Descs, 2, &Transferred) == EFI_SUCCESS);
+  assert (Transferred == 16 && Completions == 42 && Releases == 2);
+}
+static void TestValidation (void) {
+  UINT8 Buffer = 0;
+  EFI_GPI_I2C_DESCRIPTOR Descs[] = {{&Buffer, 1, 5}, {&Buffer, 1, 7}};
+  Reset ();
+  Descs[1].Length = EFI_PAGE_SIZE + 1;
+  assert (GpiI2cTransfer (&mGpi.Protocol, 10, 0x2b, Descs, 2, NULL) == EFI_BAD_BUFFER_SIZE);
+  Descs[1].Length = 1; Descs[1].Flags = 5;
+  assert (GpiI2cTransfer (&mGpi.Protocol, 10, 0x2b, Descs, 2, NULL) == EFI_INVALID_PARAMETER);
+  Descs[1].Flags = 0x87;
+  assert (GpiI2cTransfer (&mGpi.Protocol, 10, 0x2b, Descs, 2, NULL) == EFI_INVALID_PARAMETER);
+  assert (Writes == 0 && Releases == 0);
+}
+static void TestFailures (void) {
+  UINT8 Buffer = 0;
+  EFI_GPI_I2C_DESCRIPTOR Desc = {&Buffer, 1, 7};
+  for (UINT32 Fault = 0; Fault < 6; ++Fault) {
+    Reset ();
+    TransferTimeout = Fault <= 1;
+    AbortTimeout = Fault == 1;
+    StopTimeout = Fault == 2;
+    WrongPointer = Fault == 3;
+    WrongLength = Fault == 4;
+    EventResetTimeout = Fault == 5;
+    assert (EFI_ERROR (GpiI2cTransfer (&mGpi.Protocol, 10, 0x2b, &Desc, 1, NULL)));
+    assert (Releases == 1 && mGpi.Data.Host == DmaData && mGpi.TxRing.Host == TxData);
+    if (AbortTimeout || StopTimeout || EventResetTimeout) {
+      assert (mSeOwners[1][1].Poisoned);
+      UINT32 Before = Writes;
+      assert (GpiI2cTransfer (&mGpi.Protocol, 10, 0x2b, &Desc, 1, NULL) == EFI_DEVICE_ERROR);
+      assert (Before == Writes);
+    } else {
+      assert (Aborts == 1 && mSeOwners[1][1].Busy == 0);
+    }
+  }
+}
+static void TestActiveSe (void) {
+  UINT8 Buffer = 0;
+  EFI_GPI_I2C_DESCRIPTOR Desc = {&Buffer, 1, 7};
+  Reset ();
+  SeRegisters[SE_GENI_STATUS / 4] = BIT (0);
+  assert (GpiI2cTransfer (&mGpi.Protocol, 10, 0x2b, &Desc, 1, NULL) == EFI_ACCESS_DENIED);
+  assert (Writes == 0 && Aborts == 0 && Releases == 1);
+  assert (SeRegisters[SE_GENI_STATUS / 4] == BIT (0));
+}
+static void TestFirmware (void) {
+  UINT8 Buffer = 0;
+  EFI_GPI_I2C_DESCRIPTOR Desc = {&Buffer, 1, 7};
+  const UINT32 Protocols[] = {0, 1, 2, 4, 255};
+  for (UINTN Index = 0; Index < ARRAY_SIZE (Protocols); ++Index) {
+    UINT32 Transferred = 1;
+    Reset ();
+    SeRegisters[SE_GENI_FW_REVISION_RO / 4] = Protocols[Index] << 8;
+    assert (GpiI2cTransfer (&mGpi.Protocol, 10, 0x2b, &Desc, 1,
+        &Transferred) == EFI_UNSUPPORTED);
+    assert (Transferred == 0 && Writes == 0 && Aborts == 0 && Releases == 1);
+    assert (mSeOwners[1][1].Busy == 0);
+  }
+}
+int main (void) {
+  TestDmaLifetime ();
+  TestPinmux ();
+  TestOwnership ();
+  TestTransfers ();
+  TestValidation ();
+  TestFailures ();
+  TestActiveSe ();
+  TestFirmware ();
+  TestProtocolErrors ();
+  puts ("GPI: continuous rings/wrap, RX-only completion, event identity, validation and quiescence passed");
+  return 0;
+}
diff --git a/Tests/I2cFifoTransportTest.c b/Tests/I2cFifoTransportTest.c
new file mode 100644
index 0000000..a4034ec
--- /dev/null
+++ b/Tests/I2cFifoTransportTest.c
@@ -0,0 +1,129 @@
+/** @file GENI FIFO receive flow-control regression. SPDX-License-Identifier: MIT */
+#include "GeniTestCommon.h"
+#include "../Driver/I2CCrDxe/I2CCrDxe.c"
+
+static UINT32 Registers[0x1000 / 4];
+static UINT32 CommandCount;
+static UINT32 InjectIrq, InjectCommand, AbortCount;
+static BOOLEAN DropReadData, DropDone;
+static EFI_STATUS EFIAPI Pins (EFI_GPIO_CR_PROTOCOL *This, GpioConfigParams *Config) {
+  (VOID)This; (VOID)Config;
+  return EFI_SUCCESS;
+}
+static EFI_GPIO_CR_PROTOCOL Gpio = {.ConfigGpio = Pins};
+static EFI_STATUS EFIAPI Locate (EFI_GUID *Guid, VOID *Registration, VOID **Interface) {
+  (VOID)Registration;
+  if (Guid == &gEfiGpioCrProtocolGuid) *Interface = &Gpio;
+  else if (Guid == &gEfiQupCrProtocolGuid) *Interface = &mQupProtocol;
+  else return EFI_NOT_FOUND;
+  return EFI_SUCCESS;
+}
+UINT32 EFIAPI MmioRead32 (UINTN Address) {
+  UINTN Offset = Address - I2C_FIFO_SE_BASE;
+  assert (Offset < sizeof (Registers));
+  if (Offset == SE_RX_FIFO) {
+    Registers[SE_RX_FIFO_STATUS / 4] = 0;
+    return 0x11;
+  }
+  return Registers[Offset / 4];
+}
+UINT32 EFIAPI MmioWrite32 (UINTN Address, UINT32 Value) {
+  UINTN Offset = Address - I2C_FIFO_SE_BASE;
+  assert (Offset < sizeof (Registers));
+  if (Offset == SE_M_IRQ_CLEAR) Registers[SE_M_IRQ_STATUS / 4] &= ~Value;
+  else Registers[Offset / 4] = Value;
+  if (Offset == SE_M_CMD0) {
+    ++CommandCount;
+    if ((Value >> 27) == I2C_CMD_READ) {
+      /* A zero ready-for-receive threshold backpressures even an empty
+         FIFO. A short chip-ID read must remain receivable below RX_WM. */
+      if (Registers[SE_RX_RFR_WATERMARK / 4] != 0) {
+        Registers[SE_RX_FIFO_STATUS / 4] = DropReadData ? 0 : 1;
+        Registers[SE_M_IRQ_STATUS / 4] = SE_M_CMD_DONE | SE_M_RX_FIFO_LAST;
+      }
+    } else Registers[SE_M_IRQ_STATUS / 4] = SE_M_CMD_DONE;
+    if ((Value >> 27) == InjectCommand) {
+      Registers[SE_M_IRQ_STATUS / 4] |= InjectIrq;
+      if (DropDone) Registers[SE_M_IRQ_STATUS / 4] &= ~SE_M_CMD_DONE;
+    }
+  }
+  if (Offset == SE_M_CMD_CTRL) { ++AbortCount; Registers[SE_M_IRQ_STATUS / 4] = SE_M_CMD_ABORT; }
+  return Value;
+}
+UINTN EFIAPI MicroSecondDelay (UINTN Delay) { return Delay; }
+int main (void) {
+  I2C_CR_INSTANCE Instance = {0};
+  MU_I2C_SLAVE_CONFIG Config = {.SlaveAddress = 0x2b, .BusFrequencyKHz = 400,
+                               .Mode = MU_I2C_MODE_I2C};
+  UINT8 Register = 0, Id = 0;
+  MU_I2C_DESCRIPTOR Descriptors[] = {
+    {&Register, 1, MU_I2C_FLAG_START | MU_I2C_FLAG_WRITE},
+    {&Id, 1, MU_I2C_FLAG_START | MU_I2C_FLAG_READ | MU_I2C_FLAG_STOP}
+  };
+  UINT32 Transferred;
+  TestOwnership ();
+  BootServices.LocateProtocol = Locate;
+  Instance.Protocol.Instance = I2C_FIFO_INSTANCE;
+  mFifoResourcesReady = TRUE;
+  Registers[SE_HW_PARAM_0 / 4] = 16U << 16;
+  for (UINT32 Protocol = 0; Protocol < 3; ++Protocol) {
+    Registers[SE_GENI_FW_REVISION_RO / 4] = Protocol << 8;
+    assert (I2cCrFifoMuTransfer (&Instance.Protocol, &Config, Descriptors, 2,
+        NULL, NULL, 0, &Transferred) == EFI_UNSUPPORTED);
+    assert (Transferred == 0 && CommandCount == 0 && mSeOwners[1][1].Busy == 0);
+  }
+  Registers[SE_GENI_FW_REVISION_RO / 4] = 3U << 8;
+  Registers[SE_GENI_IF_DISABLE_RO / 4] = BIT (0);
+  assert (I2cCrFifoMuTransfer (&Instance.Protocol, &Config, Descriptors, 2,
+      NULL, NULL, 0, &Transferred) == EFI_UNSUPPORTED);
+  assert (Transferred == 0 && CommandCount == 0 && mSeOwners[1][1].Busy == 0);
+  Registers[SE_GENI_IF_DISABLE_RO / 4] = 0;
+  assert (I2cCrFifoMuTransfer (&Instance.Protocol, &Config, Descriptors, 2,
+      NULL, NULL, 0, &Transferred) == EFI_SUCCESS);
+  assert (Id == 0x11 && Transferred == 2 && CommandCount == 2);
+  assert (Registers[SE_RX_WATERMARK / 4] == 15);
+  assert (Registers[SE_RX_RFR_WATERMARK / 4] == 16);
+  assert (mSeOwners[1][1].Busy == 0);
+  /* Exercise the real repeated-start adapter and error cleanup: terminal
+     read NACK is valid, address/write NACK and independent GP errors are not. */
+  InjectCommand = I2C_CMD_READ;
+  InjectIrq = SE_M_GP_IRQ_1 | SE_M_CMD_FAILURE;
+  Registers[SE_M_GP_LENGTH / 4] = 1;
+  assert (I2cCrFifoMuTransfer (&Instance.Protocol, &Config, Descriptors, 2,
+      NULL, NULL, 0, &Transferred) == EFI_SUCCESS);
+  assert (Transferred == 2 && Id == 0x11 && AbortCount == 0);
+  Registers[SE_M_GP_LENGTH / 4] = 0;
+  assert (I2cCrFifoMuTransfer (&Instance.Protocol, &Config, Descriptors, 2,
+      NULL, NULL, 0, &Transferred) == EFI_DEVICE_ERROR);
+  assert (Transferred == 1 && AbortCount == 1);
+  Registers[SE_M_GP_LENGTH / 4] = 1;
+  InjectCommand = I2C_CMD_WRITE;
+  assert (I2cCrFifoMuTransfer (&Instance.Protocol, &Config, Descriptors, 2,
+      NULL, NULL, 0, &Transferred) == EFI_DEVICE_ERROR);
+  assert (Transferred == 0 && AbortCount == 2);
+  InjectCommand = I2C_CMD_READ;
+  UINT32 Errors[] = {SE_M_GP_IRQ_0, SE_M_GP_IRQ_3, SE_M_GP_IRQ_4,
+                    SE_M_CMD_OVERRUN, SE_M_ILLEGAL_CMD, SE_M_CMD_ABORT};
+  for (UINTN i = 0; i < ARRAY_SIZE (Errors); ++i) {
+    InjectIrq = SE_M_GP_IRQ_1 | SE_M_CMD_FAILURE | Errors[i];
+    assert (I2cCrFifoMuTransfer (&Instance.Protocol, &Config, Descriptors, 2,
+        NULL, NULL, 0, &Transferred) == EFI_DEVICE_ERROR);
+    assert (Transferred == 1 && mSeOwners[1][1].Busy == 0);
+  }
+  InjectIrq = SE_M_CMD_FAILURE; /* An unexplained failure is never ignored. */
+  assert (I2cCrFifoMuTransfer (&Instance.Protocol, &Config, Descriptors, 2,
+      NULL, NULL, 0, &Transferred) == EFI_DEVICE_ERROR);
+  assert (Transferred == 1 && mSeOwners[1][1].Busy == 0);
+  InjectIrq = SE_M_GP_IRQ_1 | SE_M_CMD_FAILURE;
+  DropReadData = TRUE;
+  assert (I2cCrFifoMuTransfer (&Instance.Protocol, &Config, Descriptors, 2,
+      NULL, NULL, 0, &Transferred) == EFI_DEVICE_ERROR);
+  assert (Transferred == 1 && mSeOwners[1][1].Busy == 0);
+  DropReadData = FALSE;
+  DropDone = TRUE;
+  assert (I2cCrFifoMuTransfer (&Instance.Protocol, &Config, Descriptors, 2,
+      NULL, NULL, 0, &Transferred) == EFI_TIMEOUT);
+  assert (Transferred == 1 && mSeOwners[1][1].Busy == 0);
+  puts ("FIFO: receive thresholds, repeated-START chip ID and address/data NACK handling passed");
+  return 0;
+}
diff --git a/Tests/run_geni_transport_tests.py b/Tests/run_geni_transport_tests.py
new file mode 100644
index 0000000..7fd0474
--- /dev/null
+++ b/Tests/run_geni_transport_tests.py
@@ -0,0 +1,21 @@
+#!/usr/bin/env python3
+"""Run native FIFO/GPI behavior against fake hardware with ASan/UBSan."""
+from pathlib import Path
+import subprocess
+import tempfile
+
+crane = Path(__file__).resolve().parents[1]
+edk2 = crane.parents[1] / "MU_BASECORE"
+with tempfile.TemporaryDirectory(prefix="crane-geni-test-") as tmp:
+    common = ["clang", "-std=c11", "-fshort-wchar", "-g", "-O1",
+              "-Wall", "-Wextra", "-Werror", "-DCRANE_HOST_TEST", "-DCRANE_MMIO_TEST",
+              "-fsanitize=address,undefined", "-fno-sanitize-recover=all",
+              "-ffunction-sections", "-fdata-sections",
+              "-Wl,--gc-sections", "-I" + str(crane / "Include"),
+              "-I" + str(edk2 / "MdePkg/Include"),
+              "-I" + str(edk2 / "MdePkg/Include/X64"),
+              "-I" + str(edk2 / "MdeModulePkg/Include")]
+    for source in ["GpiTransportTest.c", "I2cFifoTransportTest.c"]:
+        exe = Path(tmp) / Path(source).stem
+        subprocess.run(common + [str(crane / "Tests" / source), "-o", str(exe)], check=True)
+        subprocess.run([str(exe)], check=True)
