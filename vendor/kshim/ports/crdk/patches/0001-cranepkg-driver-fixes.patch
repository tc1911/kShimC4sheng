+EFIAPI
+ProtocolRpmhAcquireVreg (
+  IN EFI_RPMH_CR_PROTOCOL *This,
+  IN CONST CHAR8 *Name,
+  IN UINT32 VoltageMv,
+  IN UINT8 Mode,
+  OUT BOOLEAN *Owned
+  )
